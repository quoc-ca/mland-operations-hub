# ==============================================================================
# Backend Environment Configuration (.env)
# ==============================================================================
# Lưu ý: File .env chứa credentials cục bộ, không commit lên git!

# Database (khi chạy local bằng mvn / IDE không qua Docker)
JDBC_URL=jdbc:mysql://localhost:3306/ppswbs_dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8&useUnicode=true
JDBC_USER=root
JDBC_PASSWORD=sa123456
SPRING_JPA_HIBERNATE_DDL_AUTO=none
WORKSHOP_OPERATIONS_VISIBLE_LOCATION_IDS=1,2

# VNPay Payment Gateway
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
VNPAY_IPN_URL=
VNPAY_QUERY_DR_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_MERCHANT_API_IP_ADDRESS=
VNPAY_MERCHANT_API_CREATED_BY=

# Firebase Client & Admin
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_ADMIN_CREDENTIALS_PATH=./firebase-service-account.json

# Mail Configuration (smtp / captured / mock)
APP_MAIL_ADAPTER=captured
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ppswbs/catalogue

# CORS & Base URLs
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MEMBER_AUTH_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173

# GHTK Shipping Fee Quote
GHTK_QUOTE_ENABLED=false
GHTK_BASE_URL=https://services.giaohangtietkiem.vn
GHTK_TOKEN=
GHTK_PICKUP_ADDRESS=
GHTK_PICKUP_PROVINCE=
GHTK_PICKUP_DISTRICT=
GHTK_PICKUP_WARD=

# Retail Checkout
RETAIL_CHECKOUT_TEST_ACCEPTANCE_ENABLED=true

# Dev-only: fake VNPay page reached by scanning the QR with a phone (needs a public tunnel to port 8080)
PAYMENT_SIMULATOR_ENABLED=false
