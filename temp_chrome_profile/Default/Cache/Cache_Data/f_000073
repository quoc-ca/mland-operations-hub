rgin:0 0 32px;color:var(--pm-ink)}\r\n.pm-public .filter-bar{background:#fff;margin:0 0 24px}\r\n.pm-public .filter-bar .check{flex-direction:row;align-items:center;gap:8px;font-weight:400}\r\n.pm-public>.muted{font-size:12px;margin:0 0 16px}\r\n.pm-public .catalogue-grid{grid-template-columns:repeat(auto-fill,minmax(232px,1fr));gap:20px;margin-top:0}\r\n.pm-public .ring-card{border:1px solid var(--pm-line);border-radius:var(--pm-radius);padding:14px;min-height:0;gap:12px;background:#fff}\r\n.pm-public .ring-card:hover{border-color:var(--pm-accent)}\r\n.pm-public .ring-card strong{font-size:15px;font-weight:600}\r\n/* Card with a cart button (quick add): image and name open the product, the round button adds to the cart. */\r\n.pm-public .product-card{gap:8px}\r\n.pm-public .product-card-link{display:flex;flex-direction:column;gap:10px;color:inherit}\r\n/* Card layout (2026-11-14, after the owner's review): the price follows the name at a small fixed gap (the name\r\n   takes only the lines it needs, at most two); the struck original price has its own line so it shows in full;\r\n   price, original and offer badges are spaced evenly; the stock label and cart button stay at the bottom. */\r\n.pm-public .product-card-link strong{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:14px;line-height:1.35}\r\n.pm-public .product-card-info{display:flex;flex-direction:column;align-items:flex-start;gap:6px;min-width:0}\r\n.pm-public .product-card-info .price{font-size:15px;line-height:22px}\r\n.pm-public .product-card-info .offer-price{display:flex;flex-direction:column;align-items:flex-start;gap:2px}\r\n.pm-public .product-card-info .offer-was{line-height:16px}\r\n.pm-public .product-card-info .offer-badges{flex-wrap:wrap;gap:6px}\r\n.pm-public .product-card-foot{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:auto;padding-top:4px}\r\n.pm-public .cart-button{flex:none;display:grid;place-items:center;width:38px;height:38px;border:0;border-radius:50%;background:var(--pm-accent);color:var(--pm-ink);cursor:pointer;transition:transform .12s}\r\n.pm-public .cart-button:hover:not(:disabled){transform:scale(1.08)}\r\n.pm-public .cart-button:disabled{background:var(--pm-bg);color:#b8bcc4;cursor:not-allowed}\r\n.pm-public .cart-added{margin:0 0 16px}\r\n/* The same grid outside 002's pages (home page Ready Rings): no page background, the home page sets the spacing. */\r\n.pm-theme.pm-public.product-grid-standalone{background:none;color:inherit;padding:0;margin:0;min-height:0}\r\n/* Sideways strip: a card is as wide as a home-page workshop card (3 per view, 20px apart); swipe or ‹ ›. */\r\n.product-strip{display:flex;flex-direction:column;gap:12px}\r\n.product-strip-tools{display:flex;align-items:center;justify-content:space-between;gap:12px}\r\n.product-strip-tools .text-link{font-size:13px;font-weight:600}\r\n.product-strip-tools>span{display:flex;gap:8px}\r\n.strip-arrow{display:grid;place-items:center;width:36px;height:36px;border:1px solid var(--pm-line,#e5e7eb);border-radius:50%;background:#fff;color:var(--pm-ink,#1a1a1a);font-size:22px;line-height:1;cursor:pointer}\r\n.strip-arrow:hover:not(:disabled){border-color:var(--pm-ink,#1a1a1a)}\r\n.strip-arrow:disabled{opacity:.35;cursor:default}\r\n.product-strip-track{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 40px) / 3);gap:20px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;padding-bottom:6px;scrollbar-width:thin}\r\n.product-strip-item{scroll-snap-align:start;display:flex;min-width:0}\r\n.product-strip-item>.product-card{flex:1;min-width:0}\r\n.pm-public .product-strip .ring-card .product-image,.pm-public .product-strip .ring-card .ring-visual{height:200px}\r\n@media(max-width:900px){.product-strip-track{grid-auto-columns:calc((100% - 20px) / 2)}}\r\n@media(max-width:600px){.product-strip-track{grid-auto-columns:82%;gap:12px}}\r\n.quick-add{border-radius:var(--pm-radius,10px);max-width:520px}\r\n.quick-add-head{display:grid;grid-template-columns:64px 1fr auto;gap:12px;align-items:start;margin-bottom:8px}\r\n.quick-add-head img,.quick-add-head .ring-visual{width:64px;height:64px;border-radius:8px;object-fit:cover;background:var(--pm-media,#fef6c3)}\r\n.quick-add-head>div{display:flex;flex-direction:column;gap:6px;min-width:0}\r\n.quick-add-head strong{font-size:15px;font-weight:600}\r\n.quick-add-close{border:0;background:none;font-size:24px;line-height:1;color:var(--pm-muted,#6b7280);cursor:pointer;padding:0 4px}\r\n.quick-add .add-to-cart{border-top:1px solid var(--pm-line,#e5e7eb)}\r\n/* Size and quantity side by side, the (long) branch name on its own full-width row: no sideways scroll. */\r\n.quick-add .form-grid{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}\r\n.quick-add .form-grid>:nth-child(2){grid-column:1/-1;order:3}\r\n.quick-add .form-grid select,.quick-add .form-grid input{width:100%;min-width:0;box-sizing:border-box}\r\n@media(max-width:600px){.dialog-backdrop.quick-add-backdrop{align-items:flex-end;padding:0}.dialog.quick-add{max-width:none;border-radius:16px 16px 0 0}}\r\n.pm-public .ring-visual,.pm-public .product-image,.pm-public .detail-image{border-radius:var(--pm-control-radius);background:var(--pm-media);width:100%;object-fit:cover}\r\n.pm-public .ring-card .ring-visual,.pm-public .ring-card .product-image{height:160px}\r\n.pm-public .ring-visual span{display:none}\r\n.pm-public .badge{border:0;border-radius:13px;background:var(--pm-bg);color:var(--pm-muted);font-size:10px;font-weight:600;padding:5px 10px}\r\n.pm-public .price{font-size:13px;font-weight:600;color:var(--pm-ink)}\r\n.pm-public .status{align-self:flex-start;min-width:0}\r\n.pm-public .pager{justify-content:center}\r\n.pm-public .detail-grid{grid-template-columns:minmax(0,2fr) minmax(0,3fr);gap:32px;align-items:start;margin-top:0}\r\n.pm-public .detail-grid>.ring-visual,.pm-public .detail-grid .ring-visual,.pm-public .detail-image{height:auto;aspect-ratio:1/1}\r\n.pm-public .detail-grid .price{font-size:22px;font-weight:700;margin:0 0 16px}\r\n.pm-public .detail-grid p{font-size:12px;line-height:1.6;margin:0 0 16px}\r\n.pm-public .detail-grid .section-title{font-size:15px;margin:24px 0 8px}\r\n.pm-public .size-list{border-top:1px solid var(--pm-line)}\r\n.pm-public .size-list li{grid-template-columns:70px 1fr 1fr;align-items:center;min-height:52px;padding:0;border-bottom:1px solid var(--pm-line);font-size:12px}\r\n.pm-public .size-list li .muted{color:var(--pm-ok)}\r\n.pm-public .size-list li.unavailable,.pm-public .size-list li.unavailable .muted{color:var(--pm-muted)}\r\n.pm-public .thumb.active{border-color:var(--pm-accent)}\r\n.pm-public .add-to-cart{border-top:1px solid var(--pm-line);margin-top:16px;padding-top:24px;gap:16px}\r\n.pm-public .add-to-cart .form-grid{grid-template-columns:1fr 1fr;margin-bottom:0}\r\n.pm-public .add-to-cart .button{align-self:stretch;min-height:44px}\r\n.pm-public .muted.small{font-size:11px;color:var(--pm-muted);margin-top:16px}\r\n@media(max-width:820px){.pm-public{padding:32px 0 48px}.pm-public .detail-grid{grid-template-columns:1fr}.pm-public .add-to-cart .form-grid{grid-template-columns:1fr}}\r\n.pm-public .filter-bar input:not([type=checkbox]),.pm-public .filter-bar select{min-width:0;min-height:40px;padding:0 16px;border:1px solid var(--pm-input);border-radius:var(--pm-control-radius);background-color:#fff;font-size:12px}\r\n.pm-public .filter-bar select{appearance:none;padding-right:40px;background:#fff url(\"data:image/svg+xml,%3csvg%20preserveAspectRatio='none'%20overflow='visible'%20style='display:%20block;'%20width='16'%20height='16'%20viewBox='0%200%2016%2016'%20fill='none'%20xmlns='http://www.w3.org/2000/svg'%3e%3cg%20id='Chevron%20down'%3e%3cpath%20id='Icon'%20d='M4%206L8%2010L12%206'%20stroke-width='1.6'%20stroke-linecap='round'%20stroke-linejoin='round'%20stroke='%231E1E1E'/%3e%3c/g%3e%3c/svg%3e\") no-repeat right 12px center}\r\n.pm-public .filter-bar label{flex:1 1 180px}\r\n.pm-public .filter-bar label:first-child{flex:2 1 320px}\r\n.pm-public .filter-bar .check{flex:0 0 auto}\r\n.pm-public .filter-bar{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;align-items:end;gap:16px}\r\n.pm-public .filter-bar label,.pm-public .filter-bar label:first-child{min-width:0;flex:none}\r\n.pm-public .filter-bar .button{justify-self:end;min-width:110px}\r\n@media(max-width:820px){.pm-public .filter-bar{grid-template-columns:1fr 1fr}.pm-public .filter-bar label:first-child{grid-column:1/-1}}\r\n\r\n/* Product detail sections per frames 002-04…04k. */\r\n.pm-theme .workspace-card>.data-table{overflow-x:auto}\r\n.pm-theme .danger-zone{border-color:#f0c6bd}\r\n.pm-theme .data-row.current{background:transparent}\r\n.pm-theme .data-row .text-button{display:inline-flex;align-items:center;min-height:32px;margin-left:12px;padding:0 12px;border:1px solid var(--pm-line);border-radius:7px;background:#fff;color:var(--pm-ink);font-size:12px;font-weight:600;text-decoration:none}\r\n.pm-theme .data-row .text-button:disabled{opacity:.45}\r\n.pm-theme .data-row.variants .status,.pm-theme [aria-labelledby=publication-title] .status{all:unset;color:var(--pm-ink);font-size:12px}\r\n.pm-theme .data-row.variants .status.ok,.pm-theme [aria-labelledby=publication-title] .status.ok{color:var(--pm-ok);font-weight:600}\r\n.pm-theme .price-block h3{font-size:13px;font-weight:700;color:var(--pm-ink)}\r\n.pm-theme .price-block h3 .muted{font-weight:700;color:var(--pm-ink)}\r\n.pm-theme [aria-labelledby=content-title] .facts{grid-template-columns:repeat(2,minmax(0,1fr))}\r\n.pm-theme [aria-labelledby=images-title] .image-names,.pm-theme [aria-labelledby=images-title] ol{font-size:13px;color:var(--pm-muted)}\r\n.pm-theme .workspace-card .section-title{margin:32px 0 16px}\r\n.pm-theme textarea:not([hidden]){min-height:80px;line-height:1.5}\r\n\r\n/* No shared header/footer around 002 (Figma page \"002-006\"): the shell and public pages own the whole viewport. */\r\n.app-shell.pm-shell{min-height:100vh}\r\n.pm-shell .side-nav{min-height:100vh;align-self:stretch}\r\n.pm-public{min-height:100vh;width:auto;margin:0;padding:64px max(24px,calc((100% - 1056px)/2)) 88px}\r\n.pm-public .filter-bar select,.pm-public .filter-bar input:not([type=checkbox]){width:100%}\r\n\r\n/* Sign-out at the foot of the side menu (the shared header that held it is not used here). */\r\n.pm-shell .side-nav .side-signout{margin-top:auto;min-height:36px;padding:0 12px 0 28px;border:0;border-top:1px solid rgba(255,255,255,.08);background:none;color:var(--pm-muted);font-size:12px;font-weight:600;text-align:left;cursor:pointer}\r\n.pm-shell .side-nav .side-signout:hover{color:#fff}\r\n\r\n/* Size entry of the create form (size chips 5–29, range, apply to all, one row per chosen size). */\r\n.size-picker{display:flex;flex-direction:column;gap:16px;margin-bottom:8px}\r\n.size-chips{display:flex;flex-wrap:wrap;gap:8px}\r\n.size-chip{flex:none;width:52px;min-height:36px;padding:0;border:1px solid var(--pm-input,#d9d9d9);border-radius:var(--pm-control-radius,8px);background:#fff;color:var(--pm-ink,#1a1a1a);font-size:13px;font-weight:600;cursor:pointer}\r\n.size-chip:hover{border-color:var(--pm-ink,#1a1a1a)}\r\n.size-chip.on{background:var(--pm-accent,#eedc35);border-color:var(--pm-accent,#eedc35)}\r\n.size-chip:disabled{opacity:.5;cursor:default}\r\n.size-tools,.size-bulk{display:flex;flex-wrap:wrap;align-items:flex-end;gap:12px}\r\n.size-tools label,.size-bulk label{display:flex;flex-direction:column;gap:8px;font-size:12px}\r\n.pm-theme .size-tools select{width:110px}\r\n.pm-theme .size-bulk input{width:180px}\r\n.size-bulk{padding:16px;border-radius:var(--pm-control-radius,8px);background:var(--pm-bg,#f4f5f7)}\r\n.size-bulk .muted{flex-basis:100%;margin:0}\r\n.data-row.size-rows{grid-template-columns:120px minmax(0,1fr) minmax(0,1fr) 110px;gap:16px;align-items:center}\r\n.pm-theme .data-row.size-rows input{max-width:none}\r\n.data-row.size-rows .field-error{display:block;margin-top:4px}\r\n@media(max-width:820px){.data-row.size-rows{grid-template-columns:70px 1fr 1fr 80px;gap:8px}}\r\n/* Public filter rows per frame 002-07: search (2 columns), category, sort / price from, price to, buyable only, apply. */\r\n.pm-public .filter-bar{grid-template-columns:repeat(4,minmax(0,1fr))}\r\n.pm-public .filter-bar label:first-child{grid-column:span 2}\r\n.pm-public .filter-bar .check{align-self:center}\r\n/* FR-003: the size whose SKU matched the search. */\r\n.pm-theme mark.size-match{background:var(--pm-accent);color:var(--pm-ink);border-radius:4px;padding:0 4px;font-weight:700}\r\n/* Bulk price decision (initial review and per-size prices): shared amount, chosen rows, gap to the proposed price. */\r\n.price-bulk{margin:0 0 12px}\r\n.price-bulk .field{margin:0}\r\n.data-row.batch{grid-template-columns:36px .7fr 1fr 1fr 1.4fr 1fr;min-width:680px}\r\n.data-row.decision.changed,.data-row.batch.changed{background:#fffbe0}\r\n.price-gap{font-weight:700;font-size:12px}\r\n.price-gap.up{color:#16a34a}\r\n.price-gap.down{color:#b42318}\r\n.batch-prices{margin:16px 0 8px}\r\n.batch-prices>.button{margin-top:4px}\r\n.batch-results{margin:6px 0 0;padding-left:18px}\r\n/* An outcome notice under the button it belongs to: always on its own line, also inside a wrapping row of buttons. */\r\n.pm-theme .notice-at{flex:0 0 100%;width:100%;box-sizing:border-box;margin:12px 0 0}\r\n\r\n.pm-theme .data-row.products.with-actions{grid-template-columns:340fr 190fr 190fr 170fr 260fr}\r\n.pm-theme .row-actions{display:flex;flex-wrap:wrap;gap:8px;align-items:center}\r\n.pm-theme .data-row .row-actions .button{min-height:32px;min-width:0;padding:0 12px;border-radius:7px;font-size:12px;font-weight:600;line-height:1}\r\n\r\n/* Session 2026-11-08 additions, drawn with the same tokens as the rest of the management screens:\r\n   12px text and labels, 40px controls with the input border, 13px/600 chips, accent for a chosen item. */\r\n\r\n/* Quantity field (QuantityStepper): − and + sit inside the same box as the number */\r\n.qty-stepper{display:inline-flex;align-items:center;min-height:40px;max-width:100%;border:1px solid var(--pm-input,#d9d9d9);border-radius:var(--pm-control-radius,8px);background:#fff;overflow:hidden}\r\n.qty-stepper:focus-within{border-color:var(--pm-ink,#1a1a1a)}\r\n.pm-theme .qty-stepper input:not([type=checkbox]):not([type=radio]),.qty-stepper input{width:56px;min-width:0;min-height:0;height:100%;padding:0 4px;border:0;border-radius:0;background:transparent;text-align:center;font-size:12px;box-shadow:none;outline:none}\r\n.qty-stepper .qty-step{flex:none;width:28px;align-self:stretch;border:0;background:transparent;color:var(--pm-muted,#6b7280);font-size:14px;font-weight:600;line-height:1;cursor:pointer}\r\n.qty-stepper .qty-step:hover:not(:disabled){background:var(--pm-bg,#f5f5f5);color:var(--pm-ink,#1a1a1a)}\r\n.qty-stepper .qty-step:disabled{opacity:.35;cursor:not-allowed}\r\n.pm-theme .data-row.size-rows .qty-stepper input,.pm-theme .size-bulk .qty-stepper input{width:56px}\r\n/* Per-size edit in the table: a compact box, then Lưu and Hủy on the same line */\r\n.pm-theme .inline-form{flex-wrap:nowrap;gap:6px}\r\n.pm-theme .inline-form .qty-stepper{min-height:32px;height:32px}\r\n.pm-theme .inline-form .qty-stepper input:not([type=checkbox]):not([type=radio]){width:44px}\r\n.pm-theme .inline-form .qty-stepper .qty-step{width:24px}\r\n.pm-theme .inline-form .button.small{min-height:32px;padding:0 10px;font-size:12px;white-space:nowrap}\r\n.stepper-field{display:flex;flex-direction:column;gap:8px;font-size:12px}\r\n\r\n/* Manager create: publish now or keep hidden */\r\n.publish-choice{margin:24px 0 0;padding:16px;border:1px solid var(--pm-input,#d9d9d9);border-radius:var(--pm-control-radius,8px);display:flex;flex-direction:column;gap:12px;font-size:12px;color:var(--pm-ink,#1a1a1a)}\r\n.publish-choice legend{padding:0 6px;font-size:12px;font-weight:600}\r\n.publish-choice label{display:flex;gap:8px;align-items:center;font-size:12px;cursor:pointer}\r\n.publish-choice input[type=radio]{margin:0;accent-color:var(--pm-ink,#1a1a1a)}\r\n.publish-choice .muted{margin:0}\r\n\r\n/* US10 branches: options and tabs look like the size chips */\r\n.branch-choice{display:flex;flex-wrap:wrap;gap:8px;margin:8px 0}\r\n.branch-option{display:inline-flex;gap:8px;align-items:center;min-height:40px;padding:0 16px;border:1px solid var(--pm-input,#d9d9d9);border-radius:var(--pm-control-radius,8px);background:#fff;color:var(--pm-ink,#1a1a1a);font-size:12px;cursor:pointer}\r\n.branch-option:hover{border-color:var(--pm-ink,#1a1a1a)}\r\n.branch-option.on{background:var(--pm-accent,#eedc35);border-color:var(--pm-accent,#eedc35)}\r\n.branch-option strong{font-size:13px;font-weight:600}\r\n.branch-option .muted{font-size:12px}\r\n.branch-option input[type=checkbox]{margin:0;accent-color:var(--pm-ink,#1a1a1a)}\r\n.branch-tabs{display:flex;flex-wrap:wrap;gap:8px;margin:4px 0 16px}\r\n.branch-tab{display:inline-flex;gap:8px;align-items:center;min-height:40px;padding:0 16px;border:1px solid var(--pm-input,#d9d9d9);border-radius:var(--pm-control-radius,8px);background:#fff;color:var(--pm-ink,#1a1a1a);font-size:13px;font-weight:600;cursor:pointer}\r\n.branch-tab:hover{border-color:var(--pm-ink,#1a1a1a)}\r\n.branch-tab.on{background:var(--pm-accent,#eedc35);border-color:var(--pm-accent,#eedc35)}\r\n.branch-tab .status{min-width:0;min-height:20px;padding:0 8px;font-size:10px}\r\n.branch-bar{display:flex;flex-wrap:wrap;gap:12px;align-items:center;margin-bottom:16px;font-size:12px;color:var(--pm-ink,#1a1a1a)}\r\n.branch-bar > span{display:inline-flex;gap:8px;align-items:center}\r\n.pm-theme .branch-bar .text-button{display:inline-flex;align-items:center;min-height:32px;padding:0 12px;border:1px solid var(--pm-line,#e5e7eb);border-radius:7px;background:#fff;color:var(--pm-ink,#1a1a1a);font-size:12px;font-weight:600;text-decoration:none}\r\n.pm-theme .branch-bar .text-button:disabled{opacity:.45}\r\n/* A section heading opened by link (#review-title …) lands below the sticky main top bar (72px). */\r\n.pm-theme .workspace-card h2[id]{scroll-margin-top:88px}\r\n/* Public detail buy panel (2026-11-14, after the shop's sample): label column, 5-per-row size boxes, − / + quantity,\r\n   two equal buttons. One red for the panel, --pm-buy-red. */\r\n.add-to-cart{--pm-buy-red:#d0011b;--pm-buy-red-soft:#fdeeef;--pm-buy-line:#e5e5e5}\r\n.add-to-cart .buy-row{display:grid;grid-template-columns:90px minmax(0,1fr);align-items:center;column-gap:12px}\r\n.add-to-cart .buy-row-top{align-items:start}\r\n.add-to-cart .buy-row-top>.buy-label{line-height:50px}\r\n.add-to-cart .buy-label{color:#757575;font-size:14px;font-weight:400}\r\n.add-to-cart .buy-sizes{display:flex;flex-direction:column;align-items:flex-start;gap:12px;min-width:0}\r\n.add-to-cart .buy-size-list{display:grid;grid-template-columns:repeat(5,minmax(0,100px));gap:10px;width:100%}\r\n.add-to-cart .buy-size{position:relative;overflow:hidden;height:50px;padding:0 4px;border:1px solid var(--pm-buy-line);border-radius:2px;background:#fff;color:#222;font:inherit;font-size:15px;font-weight:400;cursor:pointer}\r\n.add-to-cart .buy-size:hover:not(:disabled){border-color:var(--pm-buy-red);color:var(--pm-buy-red)}\r\n.add-to-cart .buy-size:focus-visible{outline:2px solid var(--pm-buy-red);outline-offset:2px}\r\n.add-to-cart .buy-size:disabled{background:#fafafa;color:#bdbdbd;cursor:not-allowed}\r\n.add-to-cart .buy-size.active{border-color:var(--pm-buy-red);color:var(--pm-buy-red)}\r\n/* Chosen size: red triangle in the bottom-right corner with a white tick. */\r\n.add-to-cart .buy-size.active::after{content:\"\";position:absolute;right:0;bottom:0;border-style:solid;border-width:0 0 15px 15px;border-color:transparent transparent var(--pm-buy-red) transparent}\r\n.add-to-cart .buy-size.active::before{content:\"\";position:absolute;z-index:1;right:2px;bottom:3px;width:3px;height:6px;border:solid #fff;border-width:0 1.5px 1.5px 0;transform:rotate(45deg)}\r\n.add-to-cart .buy-sizes-price{font-size:15px}\r\n.add-to-cart .size-guide-link{padding:0;border:0;background:none;color:#05a;font:inherit;font-size:14px;cursor:pointer}\r\n.add-to-cart .size-guide-link span{margin-left:4px}\r\n.add-to-cart .size-guide-link:hover{text-decoration:underline}\r\n.add-to-cart .buy-branch{width:100%;max-width:400px;height:40px}\r\n.add-to-cart .buy-quantity{display:flex;align-items:center;flex-wrap:wrap;gap:8px 16px}\r\n.add-to-cart .qty-stepper{display:inline-flex;height:40px;border:1px solid var(--pm-buy-line);border-radius:2px;background:#fff}\r\n.add-to-cart .qty-stepper button{width:40px;border:0;background:#fff;color:#555;font-size:20px;line-height:1;cursor:pointer}\r\n.add-to-cart .qty-stepper button:disabled{color:#ccc;cursor:not-allowed}\r\n.add-to-cart .qty-stepper input{width:60px;min-width:0;height:100%;padding:0;border:0;border-left:1px solid var(--pm-buy-line);border-right:1px solid var(--pm-buy-line);border-radius:0;background:#fff;color:var(--pm-buy-red);font:inherit;font-size:16px;text-align:center;pointer-events:none}\r\n.add-to-cart .qty-stock{color:#757575;font-size:14px}\r\n.add-to-cart .buy-prompt{margin:0;color:var(--pm-buy-red);font-size:14px}\r\n.add-to-cart .buy-actions{display:flex;flex-wrap:wrap;gap:16px;margin-top:4px}\r\n.add-to-cart .buy-add,.add-to-cart .buy-now{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-width:200px;height:48px;padding:0 20px;border:1px solid var(--pm-buy-red);border-radius:2px;font:inherit;font-size:15px;cursor:pointer}\r\n.add-to-cart .buy-add{background:var(--pm-buy-red-soft);color:var(--pm-buy-red)}\r\n.add-to-cart .buy-add:hover:not(:disabled){background:#fbdfe2}\r\n.add-to-cart .buy-now{background:var(--pm-buy-red);color:#fff}\r\n.add-to-cart .buy-now:hover:not(:disabled){background:#b80018}\r\n.add-to-cart .buy-add:disabled,.add-to-cart .buy-now:disabled{opacity:.55;cursor:not-allowed}\r\n@media(max-width:600px){\r\n