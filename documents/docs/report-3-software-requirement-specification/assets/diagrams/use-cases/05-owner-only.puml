@startuml
!pragma charset UTF-8
title 4.3.4 Use Cases for Manager
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FCF9F8
  BorderColor #807663
  ArrowColor #5B5E67
}

actor Manager
actor "Payment Gateway" as PaymentGateway
actor "OTA Partner" as OTAPartner

rectangle "Mland Operations System" {
  package "Product" {
    usecase "Manage Products" as UC12
    usecase "Import Products from Excel" as UC13
    usecase "Submit Product or Price Proposal" as UC14
    usecase "Approve Product and Price" as UC15
    usecase "Apply Approved Price" as UC16
    usecase "Publish or Unpublish Product" as UC17
    usecase "Manage Product Categories" as UC18
  }
  package "Workshop operations" {
    usecase "Manage Workshop Schedule" as UC25
    usecase "Assign Staff to Workshop Slot" as UC26
    usecase "Configure Workshop Time Slot" as UC27
    usecase "Configure Workshop Slot Capacity" as UC28
  }
  package "Ticket settlement and changes" {
    usecase "Respond to Mland Cancellation Offer" as UC88
    usecase "Cancel Workshop Tickets" as UC84
    usecase "View Ticket Folio" as UC77
    usecase "Add Folio Charge" as UC78
    usecase "Collect Ticket Balance" as UC79
    usecase "Verify Transfer Payment" as UC80
    usecase "Manage Handover Exception and Debt" as UC81
    usecase "Correct Ticket Folio" as UC82
    usecase "Close Branch Cash Day" as UC83
    usecase "Change Ticket Sessions" as UC85
    usecase "Decide Ticket Change Request" as UC86
    usecase "Grant Extra Change Allowance" as UC87
    usecase "Submit Refund Account" as UC89
    usecase "Process Refund Request" as UC90
  }
  package "OTA channels" {
    usecase "Manage OTA Channel Mappings" as UC91
    usecase "Enable OTA Channel Booking" as UC92
    usecase "Resolve OTA Reconciliation Items" as UC93
    usecase "Reconcile OTA Payout" as UC94
    usecase "Record OTA Shop Add-on" as UC95
  }
  package "Design and consultation" {
    usecase "Chat with Staff Consultant" as UC38
    usecase "Review Custom Design Request" as UC40
  }
  package "Loyalty and promotion" {
    usecase "Manage Automatic Discounts" as UC45
    usecase "Manage Voucher Code" as UC46
    usecase "Manage Loyalty Point Policy" as UC51
  }
  package "Dashboard, queue and reviews" {
    usecase "View Dashboard" as UC64
    usecase "Configure Custom Queue" as UC68
    usecase "Moderate Review" as UC76
  }
}

