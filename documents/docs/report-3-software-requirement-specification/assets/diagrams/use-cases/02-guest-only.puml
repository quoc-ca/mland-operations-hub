@startuml
!pragma charset UTF-8
title 4.3.1 Use Cases for Guest
left to right direction
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FCF9F8
  BorderColor #807663
  ArrowColor #5B5E67
}

actor Guest

actor "SSO Provider" as SSO
actor "Payment Gateway" as Pay
actor "AI API" as AI

rectangle "Mland Operations System" {
  usecase "Register Account" as UC01
  usecase "Sign In" as UC02
  usecase "Reset Password" as UC03
  usecase "Browse Product Catalogue" as UC10
  usecase "View Product Details" as UC11
  usecase "Browse Workshop Packages" as UC19
  usecase "View Workshop Package Details" as UC20
  usecase "Create Workshop Booking" as UC21
  usecase "Pay Workshop Deposit" as UC22
  usecase "Look Up Booking Details" as UC23
  usecase "Chat with Basic AI Support" as UC33
  usecase "View and Save Vouchers" as UC47
  usecase "Browse Public Reviews" as UC74
}

Guest --> UC01
Guest --> UC02
Guest --> UC03
Guest --> UC10
Guest --> UC11
Guest --> UC19
Guest --> UC20
Guest --> UC21
Guest --> UC23
Guest --> UC33
Guest --> UC47
Guest --> UC74

UC21 ..> UC22 : <<include>>

UC01 -- SSO
UC02 -- SSO
UC03 -- SSO
UC22 -- Pay
UC33 -- AI

note right of UC47
Guest only views public vouchers.
Saving a voucher requires sign-in.
end note

note right of UC74
Creating a review requires sign-in.
end note
@enduml
