@startuml
!pragma charset UTF-8
title 4.3.2 Use Cases for Member
left to right direction
skinparam shadowing false
skinparam usecase {
  BackgroundColor #FCF9F8
  BorderColor #807663
  ArrowColor #5B5E67
}

actor Guest
actor Member

actor "SSO Provider" as SSO
actor "Payment Gateway" as Pay
actor Staff
actor Manager

rectangle "Mland Operations System" {
  usecase "Change Password" as UC04
  usecase "Manage Personal Profile" as UC05
  usecase "Select Available Ring Model" as UC36
  usecase "Configure Workshop Ring" as UC37
  usecase "Evaluate Saved Design and View Workshop Recommendation" as UC37E
  usecase "Chat with Staff Consultant" as UC38
  usecase "Submit Custom Design Request" as UC39
  usecase "View Custom Design Request Decision" as UC41
  usecase "View Loyalty Points" as UC42
  usecase "Apply Promotions and Points" as UC44
  usecase "Manage Shopping Cart" as UC53
  usecase "Checkout and Pay for Retail Order" as UC54
  usecase "View Purchase Order History" as UC56
  usecase "View Order Details" as UC57
  usecase "Submit Custom Order" as UC67
  usecase "Pay Custom Order Quote" as UC69
  usecase "View Custom Order" as UC70
  usecase "Create or Edit Own Review" as UC75
}

' Member inherits every Guest use case (see 4.3.1), including Create Workshop Booking.
Member --|> Guest

Member --> UC04
Member --> UC05
Member --> UC36
Member --> UC37
Member --> UC37E
Member --> UC38
Member --> UC39
Member --> UC41
Member --> UC42
Member --> UC53
Member --> UC54
Member --> UC56
Member --> UC57
Member --> UC67
Member --> UC70
Member --> UC69
Member --> UC75

UC44 ..> UC54 : <<extend>>

UC04 -- SSO
UC54 -- Pay
UC69 -- Pay
UC38 -- Staff
UC38 -- Manager

note bottom of UC44
Points and vouchers can also be applied
to a workshop booking (Create Workshop Booking, 4.3.1).
end note
@enduml
