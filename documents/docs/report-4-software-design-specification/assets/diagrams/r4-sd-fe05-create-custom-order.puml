@startuml
!include r4-sequence-style.puml
title FE-05 Convert Accepted Request to Custom Order
actor "Staff" as staff
actor "Manager" as manager
participant "HumanReviewService" as reviewService
participant "CustomOrderService" as orderService
participant "DesignRequestFacade" as requestFacade
database "CustomOrderRepository" as orderRepository
database "CustomOrderQuoteRepository" as quoteRepository

staff -> reviewService : accept request with explanation
activate reviewService
reviewService -> requestFacade : request accepted snapshot
activate requestFacade
requestFacade --> reviewService : immutable design/request snapshot
deactivate requestFacade
reviewService -> orderService : create custom-order command
activate orderService
orderService -> orderRepository : create custom order
activate orderRepository
orderRepository --> orderService : custom order reference
deactivate orderRepository
orderService -> quoteRepository : create quote draft
activate quoteRepository
quoteRepository --> orderService : quote draft reference
deactivate quoteRepository
orderService --> reviewService : quote preparation result
deactivate orderService
reviewService --> staff : quote preparation result
deactivate reviewService
manager -> orderService : open quote for approval
activate orderService
orderService --> manager : quote projection and version
deactivate orderService
@enduml
