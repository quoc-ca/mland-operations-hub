@startuml
!include r4-sequence-style.puml
title FE-05 Convert Accepted Request to Custom Order
actor "Staff or Manager" as Actor
participant "<<controller>>\n:DesignRequestController" as ReviewController
participant "<<service>>\n:HumanReviewService" as ReviewService
participant "<<facade>>\n:DesignRequestFacade" as RequestFacade
participant "<<service>>\n:CustomOrderService" as OrderService
participant "<<repository>>\n:CustomOrderRepository" as OrderRepo
participant "<<repository>>\n:CustomOrderQuoteRepository" as QuoteRepo
participant "<<database>>\n:MySQL Database" as DB

Actor -> ReviewController : Accept request with explanation
activate ReviewController
ReviewController -> ReviewService : record accepted decision
activate ReviewService
ReviewService -> RequestFacade : get accepted snapshot
activate RequestFacade
RequestFacade --> ReviewService : immutable design/request snapshot
deactivate RequestFacade
ReviewService -> OrderService : create custom-order command
activate OrderService
OrderService -> OrderRepo : create custom order
activate OrderRepo
OrderRepo -> DB : INSERT custom order
DB --> OrderRepo : custom order reference
OrderRepo --> OrderService : custom order reference
deactivate OrderRepo
OrderService -> QuoteRepo : create quote draft
activate QuoteRepo
QuoteRepo -> DB : INSERT quote draft
DB --> QuoteRepo : quote draft reference
QuoteRepo --> OrderService : quote draft reference
deactivate QuoteRepo
OrderService --> ReviewService : quote preparation result
deactivate OrderService
ReviewService --> ReviewController : accepted request and quote result
deactivate ReviewService
ReviewController --> Actor : Display quote preparation result
deactivate ReviewController
note over Actor
Manager approves the quote before the Member can pay in full.
end note
@enduml
