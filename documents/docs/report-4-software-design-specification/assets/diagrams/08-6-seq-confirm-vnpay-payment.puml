@startuml
!pragma charset UTF-8
hide footbox
skinparam shadowing false
skinparam roundcorner 0
skinparam sequenceMessageAlign center
skinparam SequenceLifeLineBorderColor #555555
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceGroupBorderColor #000000
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceStereotypeFontSize 9
skinparam SequenceStereotypeFontStyle italic
skinparam ParticipantPadding 20
skinparam BoxPadding 10
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ArrowColor #000000
skinparam SequenceGroupHeaderFontStyle plain

actor "Member" as Member
participant "MemberOrdersPage /\nMemberCheckoutPage" as UI <<user interaction>>
participant ":RetailPaymentService" as Pay <<service>>
participant "VNPay" as VNPAY
participant ":PaymentIngressService" as Ingress <<service>>
participant ":RetailPaymentEvidenceService" as Evidence <<service>>
participant ":GroupedCheckoutRepository" as Repo <<repository>>
participant "MySQL Database" as DB <<database>>

Member -> VNPAY : Pay the order
activate VNPAY
VNPAY -> Ingress : GET /api/v1/integrations/payments/vnpay/events (IPN, server to server)
activate Ingress
Ingress -> Ingress : Verify checksum and find the payment owner by merchant reference
alt Invalid Signature or Unknown Merchant Reference
  Ingress --> VNPAY : IPN response (RspCode 97 / 01)
else Amount or Currency Does Not Match
  Ingress --> VNPAY : IPN response (RspCode 04, AMOUNT_CURRENCY_MISMATCH)
else vnp_ResponseCode = 00 and vnp_TransactionStatus = 00
  Ingress -> Ingress : Store the IPN receipt
  Ingress -> Evidence : applyVerifiedPayment(RetailVerifiedPayment)
  activate Evidence
  Evidence -> Repo : lockById(checkoutId)
  activate Repo
  Repo -> DB : SELECT FOR UPDATE retail_grouped_checkouts
  activate DB
  DB --> Repo : locked checkout
  deactivate DB
  Repo --> Evidence : GroupedCheckout
  deactivate Repo
  alt Hold Ended or Checkout No Longer Waiting for Payment
    Evidence -> DB : INSERT retail_payment_reconciliation (reason LATE_OR_INVALID_STATE)
    activate DB
    DB --> Evidence : inserted row
    deactivate DB
  else Valid Payment
    Evidence -> Evidence : Settle the holds of every size × branch under the availability guard
    Evidence -> Evidence : markPaidWithProof("VNPAY-" + transaction)
    Evidence -> Repo : saveAndFlush(checkout)
    activate Repo
    Repo -> DB : UPDATE retail_grouped_checkouts and retail_orders (PAID)
    activate DB
    DB --> Repo : updated rows count
    deactivate DB
    Repo --> Evidence : GroupedCheckout
    deactivate Repo
    Evidence -> Evidence : createShipmentsForPaidCheckout(checkout) for GHTK branch orders
    Evidence -> Evidence : LoyaltyFacade.settleAcceptedBenefits / grantEarnedPoints (FE-06)\nCatalogueSalesFacade.recordAcceptedSale (FE-02)
  end
  Evidence --> Ingress : Return
  deactivate Evidence
  Ingress --> VNPAY : IPN response (RspCode 00)
else Payment Failed at VNPay
  Ingress -> Ingress : Store the IPN receipt only (the checkout keeps waiting until the hold ends)
  Ingress --> VNPAY : IPN response (RspCode 00)
end
deactivate Ingress
VNPAY --> Member : Redirect browser to the return page
deactivate VNPAY
Member -> UI : Open the return page
activate UI
UI --> Member : Display the payment result read from the server\n(the browser return never marks the order paid)
deactivate UI
@enduml
