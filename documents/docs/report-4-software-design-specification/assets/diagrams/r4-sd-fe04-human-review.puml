@startuml
!include r4-sequence-style.puml
title FE-04 Staff or Manager Human Review
actor "Reviewer" as reviewer
participant "DesignReviewController" as reviewController
participant "HumanReviewService" as reviewService
database "DesignRequestRepository" as requestRepository
database "HumanReviewDecisionRepository" as decisionRepository

reviewer -> reviewController : open NEED_REVIEW request
activate reviewController
reviewController -> reviewService : load scoped request
activate reviewService
reviewService -> requestRepository : find current version
activate requestRepository
requestRepository --> reviewService : request and snapshot
deactivate requestRepository
reviewService --> reviewController : safe review projection
deactivate reviewService
reviewer -> reviewController : decision + mandatory explanation + version
reviewController -> reviewService : record decision
activate reviewService
reviewService -> requestRepository : check version and state
activate requestRepository
requestRepository --> reviewService : current state
deactivate requestRepository
reviewService -> decisionRepository : append decision and audit
activate decisionRepository
decisionRepository --> reviewService : decision recorded
deactivate decisionRepository
reviewService -> requestRepository : update status
activate requestRepository
requestRepository --> reviewService : updated status
deactivate requestRepository
reviewService --> reviewController : decision result or 409 conflict
deactivate reviewService
reviewController --> reviewer : decision result or 409 conflict
deactivate reviewController

note over reviewer
Staff and Manager may review within authority.
An explanation is mandatory; Admin cannot decide.
end note
@enduml
