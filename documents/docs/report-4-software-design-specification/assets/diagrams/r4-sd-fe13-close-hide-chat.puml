@startuml
!include r4-sequence-style.puml
title FE-13 Staff/Manager Close and Member Soft-Hide Conversation
actor "Member" as Member
actor "Staff or Manager" as Operator
participant "<<view>>\n:ConsultationPages" as Pages
participant "<<controller>>\n:ConsultationController" as Controller
participant "<<service>>\n:ConsultationApplicationService" as Service
participant "<<repository>>\n:ConsultationConversationRepository" as ConversationRepo
participant "<<repository>>\n:ConsultationAuditEventRepository" as AuditRepo
participant "<<database>>\n:MySQL Database" as DB

Operator -> Pages : Close or update conversation
activate Pages
Pages -> Controller : PATCH conversation status
activate Controller
Controller -> Service : verify Staff/Manager authority
activate Service
Service -> ConversationRepo : update status
activate ConversationRepo
ConversationRepo -> DB : UPDATE conversation
DB --> ConversationRepo : updated status
ConversationRepo --> Service : updated conversation
deactivate ConversationRepo
Service -> AuditRepo : record operator action
activate AuditRepo
AuditRepo -> DB : INSERT audit event
DB --> AuditRepo : audit recorded
AuditRepo --> Service : audit recorded
deactivate AuditRepo
Service --> Controller : status result
deactivate Service
Controller --> Pages : HTTP 200 / 403 / 409
deactivate Controller
Pages --> Operator : Display status result

Member -> Pages : Confirm soft-hide closed conversation
Pages -> Controller : PATCH member visibility
Controller -> Service : verify owner, CLOSED and version
activate Service
Service -> ConversationRepo : set member-hidden flag
activate ConversationRepo
ConversationRepo -> DB : UPDATE member visibility
DB --> ConversationRepo : visibility updated
ConversationRepo --> Service : visibility updated
deactivate ConversationRepo
Service -> AuditRepo : record member hide
activate AuditRepo
AuditRepo -> DB : INSERT audit event
DB --> AuditRepo : audit recorded
AuditRepo --> Service : audit recorded
deactivate AuditRepo
Service --> Controller : hidden from Member sidebar
deactivate Service
Controller --> Pages : HTTP 200 / 409
Pages --> Member : Display hide result
deactivate Pages
note over Member,Operator
Soft-hide removes the chat from the Member sidebar only.
Messages and store history remain retained.
end note
@enduml
