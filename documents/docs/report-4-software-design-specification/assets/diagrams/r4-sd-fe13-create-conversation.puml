@startuml
!include r4-sequence-style.puml
title FE-13 Create Contextless or Design-Context Conversation
actor "Member" as member
participant "ConsultationController" as consultationController
participant "ConsultationContextService" as contextService
participant "ConsultationApplicationService" as consultationService
participant "WorkshopDesignContextPort" as designPort
participant "IndependentDesignRequestContextPort" as requestPort
database "ConsultationConversationRepository" as conversationRepository

member -> consultationController : create optional context conversation
activate consultationController
consultationController -> contextService : validate context if supplied
activate contextService
alt Feature-012 design context
  contextService -> designPort : validate owned current version
  activate designPort
  designPort --> contextService : safe design context
  deactivate designPort
else Feature-004 request context
  contextService -> requestPort : validate owned request/version
  activate requestPort
  requestPort --> contextService : safe request context
  deactivate requestPort
else no context
  contextService --> consultationController : empty context accepted
end
contextService --> consultationService : safe immutable context snapshot
deactivate contextService
consultationService -> conversationRepository : create OPEN conversation
activate consultationService
activate conversationRepository
conversationRepository --> consultationService : conversation reference
deactivate conversationRepository
consultationService --> consultationController : conversation reference and safe context
deactivate consultationService
consultationController --> member : conversation reference and safe context
deactivate consultationController
@enduml
