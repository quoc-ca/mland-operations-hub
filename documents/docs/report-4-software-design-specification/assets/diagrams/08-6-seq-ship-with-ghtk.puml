@startuml
!pragma charset UTF-8
skinparam shadowing false
skinparam roundcorner 0
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ArrowColor #000000
skinparam SequenceLifeLineBorderColor #7B61FF
skinparam SequenceLifeLineBackgroundColor #F5F5F5
skinparam SequenceGroupBorderColor #7B61FF
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceGroupHeaderFontStyle plain

actor "Staff" as Staff
actor "GHTK Partner\n(role CARRIER)" as Carrier
participant "StaffRetailOrdersPage" as StaffUI
participant "CarrierPages" as CarrierUI
participant "StaffRetailShipmentController" as StaffCtl
participant "CarrierShipmentController" as CarrierCtl
participant "StaffRetailShipmentService" as StaffSvc
participant "CarrierShipmentService" as CarrierSvc
participant "RetailShipmentRepository" as Repo
participant "Database" as DB

note over StaffSvc, DB
  A RetailShipment in state PREPARING is created for every paid GHTK branch order
  when the payment is confirmed (createShipmentsForPaidCheckout, Sequence 8.4).
end note

== Staff packs the parcel ==
Staff -> StaffUI : Click "Đã chuẩn bị xong" on an order in tab "Đơn hàng cần chuẩn bị"
activate StaffUI
StaffUI -> StaffCtl : POST /api/v1/staff/retail-shipments/{id}/transitions ({nextStatus: READY_FOR_CARRIER, expectedVersion})
activate StaffCtl
StaffCtl -> StaffSvc : transition(actor, id, nextStatus, expectedVersion, note)
activate StaffSvc
alt Not Signed In or Not an Active Staff / Manager
  StaffSvc --> StaffCtl : Throw RetailUnauthorizedException / RetailAccessDeniedException
  StaffCtl --> StaffUI : 401 Unauthorized / 403 Forbidden Response
  StaffUI --> Staff : Display error message
else Active Staff
  StaffSvc -> Repo : lockById(id)
  activate Repo
  Repo -> DB : Execute SELECT ... FOR UPDATE statement on retail_shipments
  activate DB
  DB --> Repo : Return locked shipment
  deactivate DB
  Repo --> StaffSvc : Return RetailShipment
  deactivate Repo
  alt Shipment Outside the Staff's Branches
    StaffSvc --> StaffCtl : Throw RetailAccessDeniedException
    StaffCtl --> StaffUI : 403 Forbidden Response
    StaffUI --> Staff : Display error message
  else Version Changed by Someone Else
    StaffSvc --> StaffCtl : Throw RetailConflictException
    StaffCtl --> StaffUI : 409 Conflict Response ("The shipment changed; refresh before retrying")
    StaffUI --> Staff : Display error message and reload the list
  else Valid Transition
    StaffSvc -> StaffSvc : advanceTo(READY_FOR_CARRIER) and sync the branch order state
    StaffSvc -> Repo : flush()
    activate Repo
    Repo -> DB : Execute UPDATE statement on retail_shipments and INSERT statement on retail_shipment_status_history
    activate DB
    DB --> Repo : Return updated rows count
    deactivate DB
    Repo --> StaffSvc : Return
    deactivate Repo
    StaffSvc --> StaffCtl : Return StaffRetailShipmentTransitionResult
    StaffCtl --> StaffUI : 200 OK Response
    StaffUI --> Staff : Move the order to "Chờ ĐVVC lấy hàng"
  end
end
deactivate StaffSvc
deactivate StaffCtl
deactivate StaffUI

== GHTK partner picks up and delivers ==
Carrier -> CarrierUI : Sign in and open the shipment list
activate CarrierUI
CarrierUI -> CarrierCtl : GET /api/v1/carrier/shipments?status&page&size
activate CarrierCtl
CarrierCtl -> CarrierSvc : list(actor, status, page, size)
activate CarrierSvc
alt Not an Active CARRIER Account
  CarrierSvc --> CarrierCtl : Throw RetailUnauthorizedException / RetailAccessDeniedException
  CarrierCtl --> CarrierUI : 401 Unauthorized / 403 Forbidden Response
  CarrierUI --> Carrier : Display access denied message
else Active CARRIER Account
  CarrierSvc -> Repo : findCarrierShipments(status, pageable)
  activate Repo
  Repo -> DB : Execute SELECT statement on retail_shipments of every branch
  activate DB
  DB --> Repo : Return shipment rows
  deactivate DB
  Repo --> CarrierSvc : Return page of RetailShipment
  deactivate Repo
  CarrierSvc --> CarrierCtl : Return CarrierShipmentDtos.Page (no prices, vouchers or points)
  CarrierCtl --> CarrierUI : 200 OK Response
  CarrierUI --> Carrier : Display tabs "Đang lấy hàng", "Đang giao hàng", "Đã giao hàng"

  Carrier -> CarrierUI : Click "Đã lấy hàng" (or "Giao thành công" when HANDED_TO_CARRIER or IN_TRANSIT)
  CarrierUI -> CarrierCtl : POST /api/v1/carrier/shipments/{id}/transitions ({action: PICKED_UP or DELIVERED, expectedVersion})
  CarrierCtl -> CarrierSvc : transition(actor, id, action, expectedVersion)
  CarrierSvc -> Repo : lockById(id)
  activate Repo
  Repo -> DB : Execute SELECT ... FOR UPDATE statement on retail_shipments
  activate DB
  DB --> Repo : Return locked shipment
  deactivate DB
  Repo --> CarrierSvc : Return RetailShipment
  deactivate Repo
  alt Version Changed or Step Not Allowed in the Current State
    CarrierSvc --> CarrierCtl : Throw RetailConflictException
    CarrierCtl --> CarrierUI : 409 Conflict Response ("Đơn vừa được cập nhật, hãy tải lại danh sách.")
    CarrierUI --> Carrier : Display error message
  else PICKED_UP from READY_FOR_CARRIER, or DELIVERED from HANDED_TO_CARRIER or IN_TRANSIT
    CarrierSvc -> CarrierSvc : advanceTo(HANDED_TO_CARRIER or DELIVERED) and sync the branch order state
    CarrierSvc -> Repo : flush()
    activate Repo
    Repo -> DB : Execute UPDATE statement on retail_shipments and INSERT statement on retail_shipment_status_history
    activate DB
    DB --> Repo : Return updated rows count
    deactivate DB
    Repo --> CarrierSvc : Return
    deactivate Repo
    CarrierSvc --> CarrierCtl : Return TransitionResult
    CarrierCtl --> CarrierUI : 200 OK Response
    CarrierUI --> Carrier : Move the shipment to "Đang giao hàng" (or "Đã giao hàng")
  end
end
deactivate CarrierSvc
deactivate CarrierCtl
deactivate CarrierUI
@enduml
