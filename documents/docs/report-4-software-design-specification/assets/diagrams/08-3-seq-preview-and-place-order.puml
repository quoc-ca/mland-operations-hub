@startuml
!pragma charset UTF-8
skinparam shadowing false
skinparam roundcorner 0
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ArrowColor #000000
skinparam SequenceLifeLineBorderColor #7B61FF
skinparam SequenceLifeLineBackgroundColor #F5F5F5
skinparam SequenceGroupBorderColor #7B61FF
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceGroupHeaderFontStyle plain

actor "Member" as Member
participant "MemberCheckoutPage" as UI
participant "CheckoutController" as Ctl
participant "RetailCheckoutQuotePreviewService" as Prev
participant "RetailCheckoutAcceptanceService" as Acc
participant "GhtkRetailShippingQuoteAdapter" as Ghtk
participant "LoyaltyFacade" as Loyalty
participant "RetailCheckoutQuoteRepository /\nGroupedCheckoutRepository" as Repo
participant "Database" as DB

Member -> UI : Open checkout page with the ticked cart lines (or the "Mua Ngay" line)
activate UI
UI -> UI : Group the lines into one order per branch

opt Branch Order Delivered by GHTK
  Member -> UI : Choose "Giao tận nơi qua GHTK" and enter the address
  UI -> Ctl : POST /api/v1/ready-ring-shipping-quotes (ShippingQuoteRequest {locationId, recipient, cartLineIds})
  activate Ctl
  Ctl -> Prev : quoteShipping(memberId, request)
  activate Prev
  Prev -> Ghtk : quote(memberId, locationId, lines, recipient)
  activate Ghtk
  Ghtk -> Ghtk : Request shipping fee from GHTK API and store RetailShippingQuote
  Ghtk --> Prev : Return ShippingQuote (quoteId, charge, expiresAt)
  deactivate Ghtk
  Prev --> Ctl : Return ShippingQuoteView
  deactivate Prev
  Ctl --> UI : 200 OK Response (ShippingQuoteView)
  deactivate Ctl
end

UI -> Ctl : POST /api/v1/ready-ring-benefit-previews (BenefitPreviewRequest {selection, branchOrders, cartLineIds, paymentMethod})
activate Ctl
Ctl -> Prev : preview(memberId, request)
activate Prev
Prev -> Loyalty : previewBenefits(sourceContext, selection)
activate Loyalty
Loyalty --> Prev : Return automatic discount, voucher discount, points discount and reasons
deactivate Loyalty
alt Voucher and Points Accepted
  Prev -> Prev : Share the discounts between the branch orders
  Prev -> Repo : saveAndFlush(quote)
  activate Repo
  Repo -> DB : Execute INSERT statement on retail_checkout_quotes, retail_checkout_quote_branches, retail_checkout_quote_items
  activate DB
  DB --> Repo : Return inserted rows
  deactivate DB
  Repo --> Prev : Return RetailCheckoutQuote
  deactivate Repo
else Voucher or Points Not Accepted
  Prev -> Prev : Keep the reasons; no quote is stored (previewId = null)
end
Prev --> Ctl : Return BenefitPreviewView
deactivate Prev
Ctl --> UI : 200 OK Response (BenefitPreviewView)
deactivate Ctl
UI --> Member : Display "Chi tiết thanh toán" (product discount, voucher discount, points, shipping, payable)

Member -> UI : Click "Đặt hàng"
UI -> Ctl : POST /api/v1/ready-ring-orders (Idempotency-Key, CreateGroupedCheckoutRequest {branchOrders, benefitPreviewId, benefitSelection, benefitTermsAccepted})
activate Ctl
alt Not an Active Member
  Ctl --> UI : 401 Unauthorized / 403 Forbidden Response
  UI --> Member : Redirect to Sign-in page / Display error popup
else Active Member
  Ctl -> Acc : accept(memberId, idempotencyKey, request)
  activate Acc
  Acc -> Repo : findLockedByMemberAccountId(memberId), lockOwned(benefitPreviewId, memberId)
  activate Repo
  Repo -> DB : Execute SELECT ... FOR UPDATE statement on retail_carts and retail_checkout_quotes
  activate DB
  DB --> Repo : Return locked cart and quote
  deactivate DB
  Repo --> Acc : Return RetailCart and RetailCheckoutQuote
  deactivate Repo
  opt Checkout Quote Not Found
    Acc --> Ctl : Throw RetailNotFoundException
    Ctl --> UI : 404 Not Found Response
    UI --> Member : Display error popup
  end
  Acc -> Repo : findByMemberAccountIdAndIdempotencyKey(memberId, idempotencyKey)
  activate Repo
  Repo -> DB : Execute SELECT statement on retail_grouped_checkouts
  activate DB
  DB --> Repo : Return checkout row or nothing
  deactivate DB
  Repo --> Acc : Return existing GroupedCheckout (optional)
  deactivate Repo
  alt Same Idempotency-Key Already Accepted with the Same Terms
    Acc --> Ctl : Return existing GroupedCheckoutView
    Ctl --> UI : 201 Created Response (GroupedCheckoutView)
  else Same Idempotency-Key Used for Different Terms
    Acc --> Ctl : Throw RetailConflictException ("Checkout key was used for different terms")
    Ctl --> UI : 409 Conflict Response
    UI --> Member : Display error popup
  else New Order
    Acc -> Acc : validate(quote, cart, request, saleContext, now)\nunder the locked branch sale context (FE-02)
    alt Price, Stock, Shipping Fee or Benefit Changed
      Acc --> Ctl : Throw RetailConflictException (reason)
      Ctl --> UI : 409 Conflict Response (reason)
      UI --> Member : Display the reason and refresh the quote
    else Quote Still Valid
      Acc -> Acc : Build GroupedCheckout with one RetailOrder per branch\nand split the discount between them
      Acc -> Repo : saveAndFlush(checkout)
      activate Repo
      Repo -> DB : Execute INSERT statement on retail_grouped_checkouts, retail_orders, retail_order_items
      activate DB
      DB --> Repo : Return inserted rows
      deactivate DB
      Repo --> Acc : Return GroupedCheckout
      deactivate Repo
      Acc -> Acc : Create one RetailVariantHold per size × branch under the availability guard\n(holdDeadline: 10 minutes for VNPay, 72 hours for cash at the counter)
      Acc -> Loyalty : reserveAcceptedTransaction(acceptedContext, selection, idempotencyKey)
      activate Loyalty
      Loyalty --> Acc : Return held benefits
      deactivate Loyalty
      opt Payable Total = 0
        Acc -> Acc : Settle the holds, markPaid(), createShipmentsForPaidCheckout(checkout)\nand settle the benefits (FE-06); no VNPay step
      end
      Acc -> Acc : Mark the quote accepted and remove the bought lines from the cart
      Acc --> Ctl : Return GroupedCheckoutView
      Ctl --> UI : 201 Created Response (GroupedCheckoutView)
      alt Payable Total = 0
        UI --> Member : Display the order as paid
      else Payment Method Is VNPay
        UI --> Member : Go to VNPay payment (Sequence 8.4)
      else Cash at the Counter
        UI --> Member : Open "Đơn mua" at tab "Chờ nhận tại cửa hàng"
      end
    end
  end
  deactivate Acc
end
deactivate Ctl
deactivate UI
@enduml
