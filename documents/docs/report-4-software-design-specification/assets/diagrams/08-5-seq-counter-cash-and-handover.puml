@startuml
!pragma charset UTF-8
skinparam shadowing false
skinparam roundcorner 0
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ArrowColor #000000
skinparam SequenceLifeLineBorderColor #7B61FF
skinparam SequenceLifeLineBackgroundColor #F5F5F5
skinparam SequenceGroupBorderColor #7B61FF
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceGroupHeaderFontStyle plain

actor "Staff" as Staff
participant "StaffRetailOrdersPage" as UI
participant "PickupOperationsController" as Ctl
participant "PickupOperationsService" as Svc
participant "RetailCounterCashFacade" as Cash
participant "RetailPickupOrderFacade" as Orders
participant "PickupEvidenceRepository" as Repo
participant "Database" as DB

== Cash at the counter (store pickup, paid when the customer comes) ==
Staff -> UI : Click "Xác nhận đã thu" on an order in tab "Chờ thu tiền mặt"
activate UI
UI -> Ctl : POST /api/v1/ready-ring-orders/{orderId}/counter-cash-handovers (Idempotency-Key)
activate Ctl
Ctl -> Svc : collectCashAndHandOver(actor, orderId, idempotencyKey)
activate Svc
alt Not Signed In or Not an Active Staff
  Svc --> Ctl : Throw ResponseStatusException (401 / 403)
  Ctl --> UI : 401 Unauthorized / 403 Forbidden Response
  UI --> Staff : Display error message
else Active Staff
  Svc -> Cash : collectExactAmount(actor, orderId, idempotencyKey)
  activate Cash
  Cash -> DB : Execute SELECT statement on retail_orders, then SELECT ... FOR UPDATE statement on retail_grouped_checkouts
  activate DB
  DB --> Cash : Return order and locked checkout
  deactivate DB
  alt Order Outside the Staff's Branches, Not Cash at the Counter, Deadline Passed or No Longer Payable
    Cash --> Svc : Throw Refused (403 / 409)
    Svc --> Ctl : Throw ResponseStatusException
    Ctl --> UI : 403 Forbidden / 409 Conflict Response (nothing recorded)
    UI --> Staff : Display error message
  else Order Waiting for Cash
    Cash -> Cash : Mark the branch order PAID, settle its holds and its FE-06 benefit part
    Cash -> DB : Execute UPDATE statement on retail_grouped_checkouts and retail_orders (PAID)
    activate DB
    DB --> Cash : Return updated rows count
    deactivate DB
    Cash -> DB : Execute INSERT statement on retail_cash_collections (exact amount, Staff, time)
    activate DB
    DB --> Cash : Return inserted row
    deactivate DB
    Cash --> Svc : Return CashCollected
    deactivate Cash
    Svc -> Orders : lock(orderId), markPrepared(orderId)
    activate Orders
    Orders --> Svc : Return updated order
    deactivate Orders
    Svc -> Repo : saveAndFlush(PickupEvidence PREPARED)
    activate Repo
    Repo -> DB : Execute INSERT statement on retail_pickup_evidence
    activate DB
    DB --> Repo : Return inserted row
    deactivate DB
    Repo --> Svc : Return PickupEvidence
    deactivate Repo
    Svc -> Orders : markHandedOver(orderId)
    activate Orders
    Orders --> Svc : Return completed order
    deactivate Orders
    Svc -> Repo : saveAndFlush(PickupEvidence HANDED_OVER)
    activate Repo
    Repo -> DB : Execute INSERT statement on retail_pickup_evidence
    activate DB
    DB --> Repo : Return inserted row
    deactivate DB
    Repo --> Svc : Return PickupEvidence
    deactivate Repo
    Svc --> Ctl : Return Result (HANDED_OVER, recordedAt)
    Ctl --> UI : 200 OK Response (Result)
    UI --> Staff : Display success message and move the order to "Hoàn thành"
  end
end
deactivate Svc
deactivate Ctl
deactivate UI

== Store pickup of an order paid by VNPay ==
Staff -> UI : Click "Đã chuẩn bị xong" on an order in tab "Đơn hàng cần chuẩn bị"
activate UI
UI -> Ctl : POST /api/v1/ready-ring-orders/{orderId}/preparation
activate Ctl
Ctl -> Svc : prepare(actor, orderId)
activate Svc
Svc -> Orders : lock(orderId)
activate Orders
Orders --> Svc : Return order (branch, state)
deactivate Orders
alt Order Outside the Staff's Branches
  Svc --> Ctl : Throw ResponseStatusException (403)
  Ctl --> UI : 403 Forbidden Response
  UI --> Staff : Display error message
else Already Prepared
  Svc --> Ctl : Return the earlier Result (PREPARED)
  Ctl --> UI : 200 OK Response (Result)
else Order Not Paid or Not a Store-Pickup Order
  Svc --> Ctl : Throw ResponseStatusException (409)
  Ctl --> UI : 409 Conflict Response
  UI --> Staff : Display error message
else Paid Store-Pickup Order of the Staff's Branch
  Svc -> Orders : markPrepared(orderId)
  activate Orders
  Orders --> Svc : Return updated order
  deactivate Orders
  Svc -> Repo : saveAndFlush(PickupEvidence PREPARED)
  activate Repo
  Repo -> DB : Execute INSERT statement on retail_pickup_evidence
  activate DB
  DB --> Repo : Return inserted row
  deactivate DB
  Repo --> Svc : Return PickupEvidence
  deactivate Repo
  Svc --> Ctl : Return Result (PREPARED)
  Ctl --> UI : 200 OK Response (Result)
  UI --> Staff : Move the order to "Chờ khách nhận"
end
deactivate Svc
deactivate Ctl

Staff -> UI : Check the order code shown by the Member and click "Giao cho khách"
UI -> Ctl : POST /api/v1/ready-ring-orders/{orderId}/pickup-confirmations
activate Ctl
Ctl -> Svc : handOver(actor, orderId)
activate Svc
Svc -> Orders : lock(orderId)
activate Orders
Orders --> Svc : Return order
deactivate Orders
alt Order Outside the Staff's Branches
  Svc --> Ctl : Throw ResponseStatusException (403)
  Ctl --> UI : 403 Forbidden Response
  UI --> Staff : Display error message
else Order Not Prepared Yet or Not Waiting for Pickup
  Svc --> Ctl : Throw ResponseStatusException (409)
  Ctl --> UI : 409 Conflict Response
  UI --> Staff : Display error message
else Order Prepared and Waiting for Pickup
  Svc -> Orders : markHandedOver(orderId)
  activate Orders
  Orders --> Svc : Return completed order
  deactivate Orders
  Svc -> Repo : saveAndFlush(PickupEvidence HANDED_OVER)
  activate Repo
  Repo -> DB : Execute INSERT statement on retail_pickup_evidence
  activate DB
  DB --> Repo : Return inserted row
  deactivate DB
  Repo --> Svc : Return PickupEvidence
  deactivate Repo
  Svc --> Ctl : Return Result (HANDED_OVER)
  Ctl --> UI : 200 OK Response (Result)
  UI --> Staff : Move the order to "Hoàn thành"
end
deactivate Svc
deactivate Ctl
deactivate UI
@enduml
