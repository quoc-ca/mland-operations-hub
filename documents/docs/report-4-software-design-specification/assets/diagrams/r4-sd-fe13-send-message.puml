@startuml
!include r4-sequence-style.puml
title FE-13 Send Message with Scope and Idempotency Checks
actor "Member, Staff or Manager" as Actor
participant "<<view>>\n:ConsultationPages" as Pages
participant "<<controller>>\n:ConsultationController" as Controller
participant "<<service>>\n:ConsultationApplicationService" as Service
participant "<<repository>>\n:ConsultationIdempotencyRecordRepository" as IdempotencyRepo
participant "<<repository>>\n:ConsultationMessageRepository" as MessageRepo
participant "<<repository>>\n:ConsultationAuditEventRepository" as AuditRepo
participant "<<database>>\n:MySQL Database" as DB

Actor -> Pages : Send UTF-8 text + Idempotency-Key
activate Pages
Pages -> Controller : POST message
activate Controller
Controller -> Service : authenticate and authorize participant
activate Service
Service -> IdempotencyRepo : find command key
activate IdempotencyRepo
IdempotencyRepo -> DB : SELECT idempotency record
DB --> IdempotencyRepo : existing or absent command
IdempotencyRepo --> Service : existing or absent command
deactivate IdempotencyRepo
alt New command
    Service -> MessageRepo : save immutable message
    activate MessageRepo
    MessageRepo -> DB : INSERT message
    DB --> MessageRepo : saved message
    MessageRepo --> Service : saved message
    deactivate MessageRepo
    Service -> AuditRepo : save safe metadata audit
    activate AuditRepo
    AuditRepo -> DB : INSERT audit event
    DB --> AuditRepo : audit recorded
    AuditRepo --> Service : audit recorded
    deactivate AuditRepo
    Service -> IdempotencyRepo : save outcome
    activate IdempotencyRepo
    IdempotencyRepo -> DB : INSERT idempotency result
    DB --> IdempotencyRepo : outcome recorded
    IdempotencyRepo --> Service : outcome recorded
    deactivate IdempotencyRepo
else Same key and same payload
    Service --> Controller : return original result
else Same key and changed payload
    Service --> Controller : 409 key conflict
end
Service --> Controller : message result
deactivate Service
Controller --> Pages : HTTP 201 / 409
deactivate Controller
Pages --> Actor : Display message result
deactivate Pages
note over Actor,Pages
Empty, overlong, closed or rate-limited commands are rejected.
end note
@enduml
