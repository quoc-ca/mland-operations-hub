@startuml
!include r4-sequence-style.puml
title FE-12 Configure and Save Design Version
actor "Member" as member
participant "WorkshopRingDesignController" as designController
participant "WorkshopRingDesignApplicationService" as designService
participant "DesignRuleFacade" as ruleFacade
database "RingDesignRepository" as designRepository
database "RingDesignIdempotencyRecordRepository" as idempotencyRepository

member -> designController : save model/blank parameters
activate designController
designController -> designService : validate Member, key and version
activate designService
designService -> ruleFacade : validate catalogue options and limits
activate ruleFacade
ruleFacade --> designService : valid snapshot and rules version
deactivate ruleFacade
designService -> designRepository : save immutable version
activate designRepository
designRepository --> designService : saved design version
deactivate designRepository
designService -> idempotencyRepository : record command result
activate idempotencyRepository
idempotencyRepository --> designService : command recorded
deactivate idempotencyRepository
designService --> designController : SAVED design and safe summary
deactivate designService
designController --> member : SAVED design and safe summary
deactivate designController

note over member,designController
Guest can preview locally but protected save requires sign-in.
end note
@enduml
