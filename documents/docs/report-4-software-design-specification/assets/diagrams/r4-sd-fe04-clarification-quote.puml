@startuml
!include r4-sequence-style.puml
title FE-04 Clarification, Quote Handoff and Full Payment

actor "Member" as Member
actor "Staff or Manager" as Reviewer
participant "<<view>>\n:DesignRequestPages" as Pages
participant "<<controller>>\n:DesignRequestController" as RequestController
participant "<<service>>\n:HumanReviewService" as ReviewService
participant "<<service>>\n:CustomOrderService" as OrderService
participant "<<service>>\n:QuoteService" as QuoteService
participant "<<port>>\n:PaymentGatewayCheckoutPort" as PaymentPort
participant "<<database>>\n:MySQL Database" as DB

Member -> Pages : Submit clarification revision
activate Pages
Pages -> RequestController : PATCH design request + version
activate RequestController
RequestController -> ReviewService : validate ownership and version
activate ReviewService
alt Invalid ownership or stale version
    ReviewService --> RequestController : 403 / 409 error
    RequestController --> Pages : HTTP 403 / HTTP 409
    Pages --> Member : Display retry message
else Clarification accepted
    ReviewService -> DB : UPDATE request to NEED_REVIEW
    DB --> ReviewService : revised request version
    ReviewService --> RequestController : NEED_REVIEW after revision
    RequestController --> Pages : HTTP 200
    Pages --> Member : Display awaiting review
    deactivate ReviewService
    Reviewer -> ReviewService : Accept with mandatory explanation
    activate ReviewService
    ReviewService -> OrderService : hand off accepted snapshot
    activate OrderService
    OrderService -> QuoteService : prepare quote
    activate QuoteService
    QuoteService --> OrderService : quote draft
    deactivate QuoteService
    OrderService --> ReviewService : quote handoff result
    deactivate OrderService
    ReviewService --> Reviewer : accepted request recorded
    deactivate ReviewService
    Reviewer -> QuoteService : approve quote
    activate QuoteService
    QuoteService -> DB : save approved quote and expiry
    DB --> QuoteService : approved quote
    QuoteService --> Reviewer : approved quote and expiry
    deactivate QuoteService
    Member -> Pages : Open My Custom Orders
    Pages -> OrderService : load approved quote
    activate OrderService
    OrderService --> Pages : approved quote projection
    deactivate OrderService
    Pages --> Member : Display full-payment action
    Member -> PaymentPort : Pay full quoted amount
    activate PaymentPort
    PaymentPort -> OrderService : verified full payment
    activate OrderService
    OrderService -> DB : UPDATE order to PAID
    DB --> OrderService : PAID order
    OrderService --> PaymentPort : outcome applied
    deactivate OrderService
    PaymentPort --> Member : PAID order state
    deactivate PaymentPort
end
deactivate RequestController
deactivate Pages
note over Member,Reviewer
No deposit, cart line, split payment or indefinite unpaid hold.
end note
@enduml
