@startuml
!pragma charset UTF-8
hide footbox
skinparam shadowing false
skinparam roundcorner 0
skinparam sequenceMessageAlign center
skinparam SequenceLifeLineBorderColor #555555
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceGroupBorderColor #000000
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceStereotypeFontSize 9
skinparam SequenceStereotypeFontStyle italic
skinparam ParticipantPadding 20
skinparam BoxPadding 10
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ArrowColor #000000
skinparam SequenceGroupHeaderFontStyle plain

actor "Staff" as Staff
participant "StaffRetailOrdersPage" as UI <<user interaction>>
participant ":PickupOperationsController" as Ctl <<control>>
participant ":PickupOperationsService" as Svc <<service>>
participant ":RetailCounterCashFacade" as Cash <<adapter>>
participant ":RetailPickupOrderFacade" as Orders <<adapter>>
participant ":PickupEvidenceRepository" as Repo <<repository>>
participant "MySQL Database" as DB <<database>>

Staff -> UI : Click "Xác nhận đã thu" on an order in tab "Chờ thu tiền mặt"
activate UI
UI -> Ctl : POST /api/v1/ready-ring-orders/{orderId}/counter-cash-handovers (Idempotency-Key)
activate Ctl
Ctl -> Svc : collectCashAndHandOver(actor, orderId, idempotencyKey)
activate Svc
alt Not Signed In or Not an Active Staff
  Svc --> Ctl : Throw ResponseStatusException (401 / 403)
  Ctl --> UI : HTTP 401 / HTTP 403
  UI --> Staff : Display error message
else Active Staff
  Svc -> Cash : collectExactAmount(actor, orderId, idempotencyKey)
  activate Cash
  Cash -> DB : SELECT retail_orders, then SELECT FOR UPDATE retail_grouped_checkouts
  activate DB
  DB --> Cash : order and locked checkout
  deactivate DB
  alt Order Outside the Staff's Branches, Not Cash at the Counter, Deadline Passed or No Longer Payable
    Cash --> Svc : Throw Refused (403 / 409)
    Svc --> Ctl : Throw ResponseStatusException
    Ctl --> UI : HTTP 403 / HTTP 409 nothing recorded
    UI --> Staff : Display error message
  else Order Waiting for Cash
    Cash -> Cash : Mark the branch order PAID, settle its holds and its FE-06 benefit part
    Cash -> DB : UPDATE retail_grouped_checkouts and retail_orders (PAID)
    activate DB
    DB --> Cash : updated rows count
    deactivate DB
    Cash -> DB : INSERT retail_cash_collections (exact amount, Staff, time)
    activate DB
    DB --> Cash : inserted row
    deactivate DB
    Cash --> Svc : CashCollected
    deactivate Cash
    Svc -> Orders : lock(orderId), markPrepared(orderId)
    activate Orders
    Orders --> Svc : updated order
    deactivate Orders
    Svc -> Repo : saveAndFlush(PickupEvidence PREPARED)
    activate Repo
    Repo -> DB : INSERT retail_pickup_evidence
    activate DB
    DB --> Repo : inserted row
    deactivate DB
    Repo --> Svc : PickupEvidence
    deactivate Repo
    Svc -> Orders : markHandedOver(orderId)
    activate Orders
    Orders --> Svc : completed order
    deactivate Orders
    Svc -> Repo : saveAndFlush(PickupEvidence HANDED_OVER)
    activate Repo
    Repo -> DB : INSERT retail_pickup_evidence
    activate DB
    DB --> Repo : inserted row
    deactivate DB
    Repo --> Svc : PickupEvidence
    deactivate Repo
    Svc --> Ctl : Result (HANDED_OVER, recordedAt)
    Ctl --> UI : HTTP 200 Result
    UI --> Staff : Display success message and move the order to "Hoàn thành"
  end
end
deactivate Svc
deactivate Ctl
deactivate UI
@enduml
