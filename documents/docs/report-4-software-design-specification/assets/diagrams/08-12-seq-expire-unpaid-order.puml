@startuml
!pragma charset UTF-8
hide footbox
skinparam shadowing false
skinparam defaultFontSize 15
skinparam roundcorner 0
skinparam sequenceMessageAlign center
skinparam SequenceLifeLineBorderColor #555555
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceGroupBorderColor #000000
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceStereotypeFontSize 9
skinparam SequenceStereotypeFontStyle italic
skinparam ParticipantPadding 20
skinparam BoxPadding 10
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ArrowColor #000000
skinparam SequenceGroupHeaderFontStyle plain

participant ":RetailUnstartedExpiryJob" as Job <<service>>
participant ":RetailUnstartedExpiryService" as Expiry <<service>>
participant ":RetailCartRepository /\nGroupedCheckoutRepository" as Repo <<repository>>
participant "MySQL Database" as DB <<database>>

loop Every 30 seconds (fixed delay), for each due checkout
  activate Job
  Job -> Expiry : expire(memberId, checkoutId)
  activate Expiry
  Expiry -> Repo : findLockedByMemberAccountId(memberId), lockOwned(checkoutId, memberId)
  activate Repo
  Repo -> DB : SELECT FOR UPDATE retail_carts and retail_grouped_checkouts
  activate DB
  DB --> Repo : locked cart and checkout
  deactivate DB
  Repo --> Expiry : RetailCart and GroupedCheckout
  deactivate Repo
  alt Payment Already Started, or Hold Not Ended Yet
    Expiry --> Job : false (skip, nothing released)
  else Hold Ended Without Payment
    Expiry -> Expiry : Expire the holds and restore the lines to the cart
    Expiry -> Expiry : expireUnpaid()
    Expiry -> Repo : saveAndFlush(checkout)
    activate Repo
    Repo -> DB : UPDATE retail_grouped_checkouts and retail_orders (EXPIRED)
    activate DB
    DB --> Repo : updated rows count
    deactivate DB
    Repo --> Expiry : GroupedCheckout
    deactivate Repo
    Expiry -> Expiry : LoyaltyFacade.releaseHeldBenefits(outcome) (FE-06)
    Expiry --> Job : true
  end
  deactivate Expiry
  deactivate Job
end
@enduml
