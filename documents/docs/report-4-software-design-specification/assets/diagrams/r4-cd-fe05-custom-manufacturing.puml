@startuml
!include r4-diagram-style.puml
title FE-05 Personalized Design and Custom Manufacturing
left to right direction
skinparam classAttributeIconSize 0
class CustomManufacturingController <<controller>>
class CustomOrderService <<service>>
class CustomOrder <<entity>>
class CustomOrderQuote <<entity>>
class CustomOrderPaymentContext <<entity>>
class CustomOrderPaymentFacade <<facade>>
class CustomOrderRepository <<repository>>
class CustomOrderQuoteRepository <<repository>>
interface PaymentGatewayCheckoutPort <<port>>
interface DesignRequestFacade <<facade>>
class ProductionFulfilmentFacade <<facade>>
CustomManufacturingController --> CustomOrderService
CustomOrderService --> DesignRequestFacade
CustomOrderService --> CustomOrderRepository
CustomOrderService --> CustomOrderQuoteRepository
CustomOrderService --> CustomOrderPaymentFacade
CustomOrderPaymentFacade --> PaymentGatewayCheckoutPort
CustomOrder "1" o-- "0..*" CustomOrderQuote
CustomOrder "1" o-- "0..1" CustomOrderPaymentContext
CustomOrderService --> ProductionFulfilmentFacade
note right of CustomOrder
One full-payment order lifecycle.
No retail cart or deposit.
end note
@enduml
