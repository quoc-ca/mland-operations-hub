@startuml
!include r4-sequence-style.puml
title FE-05 Manager Approves Quote and Member Pays in Full
actor "Manager" as manager
actor "Member" as member
participant "CustomOrderService" as orderService
participant "CustomOrderPaymentFacade" as paymentFacade
participant "PaymentGatewayCheckoutPort" as paymentPort
database "CustomOrderQuoteRepository" as quoteRepository

manager -> orderService : approve quote + version
activate orderService
orderService -> quoteRepository : save approved quote and expiry
activate quoteRepository
quoteRepository --> orderService : approved quote
deactivate quoteRepository
orderService --> manager : quote approved
deactivate orderService
member -> orderService : open My Custom Orders
activate orderService
orderService --> member : approved quote projection
deactivate orderService
member -> paymentFacade : start full payment
activate paymentFacade
paymentFacade -> paymentPort : create checkout URL
activate paymentPort
paymentPort --> paymentFacade : payment redirect
deactivate paymentPort
paymentFacade --> member : payment redirect
paymentPort --> paymentFacade : verified callback
activate orderService
paymentFacade -> orderService : apply PAID outcome idempotently
orderService --> paymentFacade : PAID and production pending
deactivate orderService
deactivate paymentFacade
paymentFacade --> member : PAID and production pending

note over member
Expired unpaid quote cannot be paid.
end note
@enduml
