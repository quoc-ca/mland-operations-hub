@startuml
!include r4-sequence-style.puml
title FE-04 Submit Member Design Request
actor "Member" as member
participant "DesignRequestController" as requestController
participant "HumanReviewService" as reviewService
participant "ImageQualityService" as imageService
participant "DesignSnapshotFacade" as snapshotFacade
database "DesignRequestRepository" as requestRepository

member -> requestController : submit description/images/design reference
activate requestController
requestController -> reviewService : validate active Member and command
activate reviewService
reviewService -> imageService : validate consent and image quality
activate imageService
imageService --> reviewService : valid or validation error
deactivate imageService
reviewService -> snapshotFacade : copy owned safe design snapshot (optional)
activate snapshotFacade
snapshotFacade --> reviewService : immutable snapshot
deactivate snapshotFacade
reviewService -> requestRepository : save NEED_REVIEW request
activate requestRepository
requestRepository --> reviewService : request version
deactivate requestRepository
reviewService --> requestController : safe request projection
deactivate reviewService
requestController --> member : status NEED_REVIEW
deactivate requestController

note over member,requestController
Guest sees the entry but is sent to sign-in.
No AI call, booking, cart or payment is created.
end note
@enduml
