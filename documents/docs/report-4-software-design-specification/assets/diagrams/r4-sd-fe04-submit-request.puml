@startuml
!include r4-sequence-style.puml
title FE-04 Submit Member Design Request

actor "Member" as Actor
participant "<<view>>\n:DesignRequestPages" as Pages
participant "<<controller>>\n:DesignRequestController" as Controller
participant "<<service>>\n:HumanReviewService" as Service
participant "<<service>>\n:ImageQualityService" as ImageService
participant "<<facade>>\n:DesignSnapshotFacade" as SnapshotFacade
participant "<<repository>>\n:DesignRequestRepository" as Repo
participant "<<database>>\n:MySQL Database" as DB

Actor -> Pages : Open design request form
activate Pages
Pages -> Controller : POST /api/v1/design-requests\n(description, images, consent, design reference)
activate Controller
Controller -> Service : submit(Member, command)
activate Service
alt Invalid Member identity or request input
    Service --> Controller : Validation or authorization error
    Controller --> Pages : HTTP 400 / 401 / 403 / 422
    Pages --> Actor : Display access or validation error
else Image consent or quality invalid
    Service -> ImageService : validateConsentAndQuality(command)
    activate ImageService
    ImageService --> Service : Invalid consent or blurry image
    deactivate ImageService
    Service --> Controller : ImageValidationException
    Controller --> Pages : HTTP 422
    Pages --> Actor : Ask for consent or replacement image
else Valid Member request
    Service -> ImageService : validateConsentAndQuality(command)
    activate ImageService
    ImageService --> Service : Valid images
    deactivate ImageService
    opt Member attaches saved Feature-012 design
        Service -> SnapshotFacade : getOwnedSnapshot(Member, designReference)
        activate SnapshotFacade
        SnapshotFacade --> Service : Immutable design snapshot
        deactivate SnapshotFacade
    end
    Service -> Repo : save NEED_REVIEW request
    activate Repo
    Repo -> DB : INSERT design_requests
    activate DB
    DB --> Repo : request id and version
    deactivate DB
    Repo --> Service : DesignRequest
    deactivate Repo
    Service --> Controller : SafeDesignRequestResponse
    deactivate Service
    Controller --> Pages : HTTP 202 / HTTP 200
    deactivate Controller
    Pages --> Actor : Display status NEED_REVIEW
end
deactivate Pages
note over Actor,Pages
Guest sees the entry but is sent to sign-in.
No AI call, booking, cart or payment is created.
end note
@enduml
