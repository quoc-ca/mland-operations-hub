@startuml
!pragma charset UTF-8
hide footbox
skinparam shadowing false
skinparam defaultFontSize 15
skinparam roundcorner 0
skinparam sequenceMessageAlign center
skinparam SequenceLifeLineBorderColor #555555
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceGroupBorderColor #000000
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceStereotypeFontSize 9
skinparam SequenceStereotypeFontStyle italic
skinparam ParticipantPadding 20
skinparam BoxPadding 10
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ArrowColor #000000
skinparam SequenceGroupHeaderFontStyle plain

actor "Member" as Member
participant "MemberOrdersPage /\nMemberCheckoutPage" as UI <<user interaction>>
participant ":CheckoutController" as Ctl <<control>>
participant ":RetailPaymentService" as Pay <<service>>
participant ":VnpayRetailPaymentAdapter" as Adapter <<adapter>>
participant ":GroupedCheckoutRepository" as Repo <<repository>>
participant "MySQL Database" as DB <<database>>

Member -> UI : Click "Thanh toán"
activate UI
UI -> Ctl : POST /api/v1/ready-ring-checkouts/{checkoutId}/payment
activate Ctl
alt Not an Active Member
  Ctl --> UI : HTTP 401 / HTTP 403
  UI --> Member : Redirect to Sign-in page / Display error popup
else Active Member
  Ctl -> Pay : initiate(memberId, checkoutId)
  activate Pay
  Pay -> Repo : lockOwned(checkoutId, memberId)
  activate Repo
  Repo -> DB : SELECT FOR UPDATE retail_grouped_checkouts
  activate DB
  DB --> Repo : locked checkout
  deactivate DB
  Repo --> Pay : GroupedCheckout
  deactivate Repo
  alt Checkout Already Paid
    Pay --> Ctl : PaymentRedirectView (PAID, no URL)
    Ctl --> UI : HTTP 200
    UI --> Member : Display the order as paid
  else VNPay Link of This Checkout Still Valid
    Pay --> Ctl : PaymentRedirectView (stored payment URL)
    Ctl --> UI : HTTP 200
    UI --> Member : Redirect to the same VNPay page
  else Cash at the Counter, Wrong State or Hold Ended
    Pay --> Ctl : Throw RetailConflictException
    Ctl --> UI : HTTP 409 reason
    UI --> Member : Display error popup
  else Waiting for Payment
    Pay -> Pay : beginPayment() (state PAYMENT_INITIATED)
    Pay -> Adapter : initiate(checkoutId, payableAmount)
    activate Adapter
    Adapter --> Pay : signed VNPay URL valid until the 10-minute hold ends
    deactivate Adapter
    Pay -> Pay : rememberPaymentLink(paymentUrl, expiresAt)
    Pay --> Ctl : PaymentRedirectView (paymentUrl, expiresAt)
    Ctl --> UI : HTTP 200 PaymentRedirectView
    UI --> Member : Redirect to VNPay
  end
  deactivate Pay
end
deactivate Ctl
deactivate UI
@enduml
