@startuml
!pragma charset UTF-8
hide footbox
skinparam shadowing false
skinparam roundcorner 0
skinparam sequenceMessageAlign center
skinparam SequenceLifeLineBorderColor #555555
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceGroupBorderColor #000000
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceStereotypeFontSize 9
skinparam SequenceStereotypeFontStyle italic
skinparam ParticipantPadding 20
skinparam BoxPadding 10
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ArrowColor #000000
skinparam SequenceGroupHeaderFontStyle plain

actor "Member" as Member
participant "AddToCartPanel" as UI <<user interaction>>
participant ":CartController" as Ctl <<control>>
participant ":CartService" as Svc <<service>>
participant ":RetailCataloguePort" as Cat <<adapter>>
participant ":RetailCartRepository" as Repo <<repository>>
participant "MySQL Database" as DB <<database>>

Member -> UI : Choose size, branch, quantity and click "Thêm Vào Giỏ Hàng" or "Mua Ngay"
activate UI
alt User Not Signed In
  UI --> Member : Redirect to Sign-in page
else User Signed In
  UI -> Ctl : POST /api/v1/members/me/ready-ring-cart/lines (AddCartLineRequest {variantId, locationId, quantity})
  activate Ctl
  alt Not an Active Member
    Ctl --> UI : HTTP 401 / HTTP 403
    UI --> Member : Display error popup
  else Active Member
    Ctl -> Svc : addLine(memberAccountId, request)
    activate Svc
    Svc -> Cat : isEligibleForCart(variantId, locationId)
    activate Cat
    Cat --> Svc : eligibility
    deactivate Cat
    Svc -> Repo : findByMemberAccountId(memberAccountId)
    activate Repo
    Repo -> DB : SELECT retail_carts and retail_cart_lines
    activate DB
    DB --> Repo : cart rows
    deactivate DB
    Repo --> Svc : RetailCart (new empty cart when none)
    deactivate Repo
    Svc -> Cat : readCartProduct(variantId, locationId)
    activate Cat
    Cat --> Svc : CartProductFact (price, saleEligible, availableQuantity)
    deactivate Cat
    alt Not Eligible, Not on Sale, More Than 99 of the Size or More Than 50 Lines
      Svc --> Ctl : Throw RetailConflictException
      Ctl --> UI : HTTP 409 reason
      UI --> Member : Display popup with the reason and "Đồng ý"
    else Quantity in Cart + Requested > Branch Stock
      Svc --> Ctl : Throw RetailConflictException (RETAIL_CART_QUANTITY_LIMIT when the size is already in the cart)
      Ctl --> UI : HTTP 409 "Bạn đã có n sản phẩm này trong giỏ hàng..."
      alt "Mua Ngay" and RETAIL_CART_QUANTITY_LIMIT
        UI -> Ctl : GET /api/v1/members/me/ready-ring-cart
        Ctl --> UI : HTTP 200 RetailCartView
        UI --> Member : Open checkout page with the existing cart line
      else Otherwise
        UI --> Member : Display popup with the message and "Đồng ý"
      end
    else Quantity Accepted
      alt Same Size and Branch Already in Cart
        Svc -> Svc : Increase quantity of the existing CartLine
      else New Size or Branch
        Svc -> Svc : Add new CartLine
      end
      Svc -> Repo : save(cart)
      activate Repo
      Repo -> DB : INSERT / UPDATE retail_cart_lines
      activate DB
      DB --> Repo : saved rows
      deactivate DB
      Repo --> Svc : saved RetailCart
      deactivate Repo
      Svc --> Ctl : RetailCartView
      Ctl --> UI : HTTP 200 RetailCartView
      alt "Mua Ngay"
        UI --> Member : Open checkout page with the new cart line
      else "Thêm Vào Giỏ Hàng"
        UI --> Member : Navigate to cart page
      end
    end
    deactivate Svc
  end
  deactivate Ctl
end
deactivate UI
@enduml
