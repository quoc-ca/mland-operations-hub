@startuml
!pragma charset UTF-8
hide footbox
skinparam shadowing false
skinparam defaultFontSize 15
skinparam roundcorner 0
skinparam sequenceMessageAlign center
skinparam SequenceLifeLineBorderColor #555555
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceGroupBorderColor #000000
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceStereotypeFontSize 9
skinparam SequenceStereotypeFontStyle italic
skinparam ParticipantPadding 20
skinparam BoxPadding 10
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ArrowColor #000000
skinparam SequenceGroupHeaderFontStyle plain

actor "Member" as Member
participant "MemberCheckoutPage" as UI <<user interaction>>
participant ":CheckoutController" as Ctl <<control>>
participant ":RetailCheckoutAcceptanceService" as Acc <<service>>
participant ":LoyaltyFacade" as Loyalty <<adapter>>
participant ":RetailCheckoutQuoteRepository /\nGroupedCheckoutRepository" as Repo <<repository>>
participant "MySQL Database" as DB <<database>>

Member -> UI : Click "Đặt hàng"
activate UI
UI -> Ctl : POST /api/v1/ready-ring-orders (Idempotency-Key, CreateGroupedCheckoutRequest {branchOrders, benefitPreviewId, benefitSelection, benefitTermsAccepted})
activate Ctl
alt Not an Active Member
  Ctl --> UI : HTTP 401 / HTTP 403
  UI --> Member : Redirect to Sign-in page / Display error popup
else Active Member
  Ctl -> Acc : accept(memberId, idempotencyKey, request)
  activate Acc
  Acc -> Repo : findLockedByMemberAccountId(memberId), lockOwned(benefitPreviewId, memberId)
  activate Repo
  Repo -> DB : SELECT FOR UPDATE retail_carts and retail_checkout_quotes
  activate DB
  DB --> Repo : locked cart and quote
  deactivate DB
  Repo --> Acc : RetailCart and RetailCheckoutQuote
  deactivate Repo
  Acc -> Repo : findByMemberAccountIdAndIdempotencyKey(memberId, idempotencyKey)
  activate Repo
  Repo -> DB : SELECT retail_grouped_checkouts
  activate DB
  DB --> Repo : checkout row or nothing
  deactivate DB
  Repo --> Acc : existing GroupedCheckout (optional)
  deactivate Repo
  alt Checkout Quote Not Found
    Acc --> Ctl : Throw RetailNotFoundException
    Ctl --> UI : HTTP 404
    UI --> Member : Display error popup
  else Same Idempotency-Key Already Accepted with the Same Terms
    Acc --> Ctl : existing GroupedCheckoutView
    Ctl --> UI : HTTP 201 GroupedCheckoutView
  else Same Idempotency-Key Used for Different Terms
    Acc --> Ctl : Throw RetailConflictException ("Checkout key was used for different terms")
    Ctl --> UI : HTTP 409
    UI --> Member : Display error popup
  else New Order
    Acc -> Acc : validate(quote, cart, request, saleContext, now)\nunder the locked branch sale context (FE-02)
    alt Price, Stock, Shipping Fee or Benefit Changed
      Acc --> Ctl : Throw RetailConflictException (reason)
      Ctl --> UI : HTTP 409 reason
      UI --> Member : Display the reason and refresh the quote
    else Quote Still Valid
      Acc -> Acc : Build GroupedCheckout with one RetailOrder per branch\nand split the discount between them
      Acc -> Repo : saveAndFlush(checkout)
      activate Repo
      Repo -> DB : INSERT retail_grouped_checkouts, retail_orders, retail_order_items
      activate DB
      DB --> Repo : inserted rows
      deactivate DB
      Repo --> Acc : GroupedCheckout
      deactivate Repo
      Acc -> Acc : Create one RetailVariantHold per size × branch under the availability guard\n(holdDeadline: 10 minutes for VNPay, 72 hours for cash at the counter)
      Acc -> Loyalty : reserveAcceptedTransaction(acceptedContext, selection, idempotencyKey)
      activate Loyalty
      Loyalty --> Acc : held benefits
      deactivate Loyalty
      Acc -> Acc : When the payable total is 0, settle the holds, markPaid(), createShipmentsForPaidCheckout(checkout)\nand settle the benefits (FE-06); no VNPay step
      Acc -> Acc : Mark the quote accepted and remove the bought lines from the cart
      Acc --> Ctl : GroupedCheckoutView
      Ctl --> UI : HTTP 201 GroupedCheckoutView
      UI --> Member : Payable total 0: display the order as paid\nVNPay: go to the VNPay payment\nCash at the counter: open "Đơn mua" at tab "Chờ nhận tại cửa hàng"
    end
  end
  deactivate Acc
end
deactivate Ctl
deactivate UI
@enduml
