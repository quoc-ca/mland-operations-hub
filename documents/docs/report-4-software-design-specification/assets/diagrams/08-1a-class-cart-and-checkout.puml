@startuml
title 8.1a Class Diagram — Cart and Checkout (FE-08)
!pragma charset UTF-8
skinparam shadowing false
skinparam roundcorner 0
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 30
skinparam ranksep 50
skinparam ArrowColor #000000
skinparam defaultFontSize 16
skinparam class {
  BorderColor #000000
  BackgroundColor #F5F5F5
  BackgroundColor<<controller>> #DAE8FC
  BackgroundColor<<service>> #D5E8D4
  BackgroundColor<<repository>> #E1D5E7
  BackgroundColor<<interface>> #FFF2CC
  BackgroundColor<<adapter>> #FFE6CC
  BackgroundColor<<entity>> #F5F5F5
  BackgroundColor<<DTO>> #FFFFFF
  BackgroundColor<<exception>> #F5F5F5
  FontStyle bold
  AttributeFontStyle plain
  StereotypeFontStyle plain
}
top to bottom direction
hide circle

class CartController <<controller>> {
  - actorResolver : RetailActorResolver
  - cartService : CartService
  + getCart() : RetailCartView
  + addLine(body) : RetailCartView
  + updateLine(lineId, body) : RetailCartView
  + removeLine(lineId) : ResponseEntity<Void>
}

class CheckoutController <<controller>> {
  - actorResolver : RetailActorResolver
  - paymentService : RetailPaymentService
  - quotePreview : ObjectProvider<RetailCheckoutQuotePreviewService>
  + quoteShipping(body) : ShippingQuoteView
  + previewBenefits(body) : BenefitPreviewView
  + createCheckout(idempotencyKey, body) : GroupedCheckoutView
  + initiatePayment(checkoutId) : PaymentRedirectView
}

class CartService <<service>> {
  - cartRepository : RetailCartRepository
  - cataloguePort : RetailCataloguePort
  + getCart(memberAccountId) : RetailCartView
  + addLine(memberAccountId, request) : RetailCartView
  + updateLine(memberAccountId, lineId, request) : RetailCartView
  + removeLine(memberAccountId, lineId) : void
}

class RetailCataloguePort <<interface>> {
  + isEligibleForCart(variantId, locationId) : boolean
  + readCartProduct(variantId, locationId) : CartProductFact
}

class RetailCheckoutQuotePreviewService <<service>> {
  - carts : RetailCartRepository
  - quotes : RetailCheckoutQuoteRepository
  - catalogue : CatalogueSalesFacade
  + quoteShipping(memberId, request) : ShippingQuoteView
  + preview(memberId, request) : BenefitPreviewView
}

class RetailCheckoutAcceptanceService <<service>> {
  - carts : RetailCartRepository
  - quotes : RetailCheckoutQuoteRepository
  - checkouts : GroupedCheckoutRepository
  + accept(memberId, idempotencyKey, request) : GroupedCheckoutView
}

class RetailCheckoutQuoteValidator <<service>> {
  + validate(quote, cart, request, context, now) : void
}

class RetailVariantHoldLifecycleService <<service>> {
  - holds : RetailVariantHoldRepository
  - availability : RetailAvailabilityGuardService
  + createHeld(checkout, variantId, locationId, quantity, expiresAt) : RetailVariantHold
  + requireBranchHolds(checkoutId, keys) : List<RetailVariantHold>
  + settle(hold) : void
  + release(hold) : void
  + expire(hold) : void
}

class LoyaltyFacade <<interface>> {
  + previewBenefits(context, selection) : BenefitPreview
  + reserveAcceptedTransaction(context, selection, key) : AcceptedBenefitRef
}

class CatalogueSalesFacade <<interface>> {
  + readBranchSaleFacts(keys) : List<BranchCartSaleFact>
  + withLockedBranchSaleContext(keys, work) : T
}

class RetailCartRepository <<repository>> {
  + findByMemberAccountId(memberAccountId) : Optional<RetailCart>
  + findLockedByMemberAccountId(memberAccountId) : Optional<RetailCart>
}

class RetailCheckoutQuoteRepository <<repository>> {
  + lockOwned(id, memberId) : Optional<RetailCheckoutQuote>
}

class GroupedCheckoutRepository <<repository>> {
  + findByMemberAccountIdAndIdempotencyKey(memberAccountId, idempotencyKey) : Optional<GroupedCheckout>
  + lockOwned(id, memberId) : Optional<GroupedCheckout>
  + lockById(id) : Optional<GroupedCheckout>
}

class RetailVariantHoldRepository <<repository>> {
  + findByGroupedCheckoutId(groupedCheckoutId) : List<RetailVariantHold>
  + sumValidHeldByVariantAndLocation(variantIds, ...) : List<BranchHeldQuantity>
}

class RetailCart <<entity>> {
  - id : String
  - memberAccountId : Long
  - version : Long
}

class CartLine <<entity>> {
  - id : String
  - cart : RetailCart
  - variantId : Long
}

class RetailCheckoutQuote <<entity>> {
  - id : String
  - memberAccountId : Long
  - cartId : String
}

class GroupedCheckout <<entity>> {
  - id : String
  - memberAccountId : Long
  - idempotencyKey : String
}

class RetailOrder <<entity>> {
  - id : String
  - groupedCheckout : GroupedCheckout
  - locationId : Long
}

class OrderItem <<entity>> {
  - id : String
  - retailOrder : RetailOrder
  - variantId : Long
}

class RetailVariantHold <<entity>> {
  - id : String
  - groupedCheckout : GroupedCheckout
  - variantId : Long
}

CartController --> CartService : uses
CheckoutController --> RetailCheckoutQuotePreviewService : uses
CheckoutController --> RetailCheckoutAcceptanceService : uses

CartService --> RetailCataloguePort : uses
CartService --> RetailCartRepository : uses
RetailCheckoutQuotePreviewService --> RetailCartRepository : uses
RetailCheckoutQuotePreviewService --> RetailCheckoutQuoteRepository : uses
RetailCheckoutQuotePreviewService --> LoyaltyFacade : uses
RetailCheckoutQuotePreviewService --> CatalogueSalesFacade : uses
RetailCheckoutAcceptanceService --> RetailCartRepository : uses
RetailCheckoutAcceptanceService --> RetailCheckoutQuoteRepository : uses
RetailCheckoutAcceptanceService --> GroupedCheckoutRepository : uses
RetailCheckoutAcceptanceService --> RetailCheckoutQuoteValidator : uses
RetailCheckoutAcceptanceService --> RetailVariantHoldLifecycleService : uses
RetailCheckoutAcceptanceService --> LoyaltyFacade : uses
RetailCheckoutAcceptanceService --> CatalogueSalesFacade : uses
RetailVariantHoldLifecycleService --> RetailVariantHoldRepository : uses

RetailCartRepository ..> RetailCart : manages
RetailCheckoutQuoteRepository ..> RetailCheckoutQuote : manages
GroupedCheckoutRepository ..> GroupedCheckout : manages
RetailVariantHoldRepository ..> RetailVariantHold : manages

RetailCart "1" *-- "*" CartLine
GroupedCheckout "1" *-- "*" RetailOrder
RetailOrder "1" *-- "*" OrderItem
GroupedCheckout "1" -- "*" RetailVariantHold
@enduml
