@startuml
!pragma charset UTF-8
hide footbox
skinparam shadowing false
skinparam roundcorner 0
skinparam sequenceMessageAlign center
skinparam SequenceLifeLineBorderColor #555555
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceGroupBorderColor #000000
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceStereotypeFontSize 9
skinparam SequenceStereotypeFontStyle italic
skinparam ParticipantPadding 20
skinparam BoxPadding 10
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ArrowColor #000000
skinparam SequenceGroupHeaderFontStyle plain

actor "Staff" as Staff
participant "StaffRetailOrdersPage" as UI <<user interaction>>
participant ":PickupOperationsController" as Ctl <<control>>
participant ":PickupOperationsService" as Svc <<service>>
participant ":RetailPickupOrderFacade" as Orders <<adapter>>
participant ":PickupEvidenceRepository" as Repo <<repository>>
participant "MySQL Database" as DB <<database>>

Staff -> UI : Click "Đã chuẩn bị xong" on an order in tab "Đơn hàng cần chuẩn bị"
activate UI
UI -> Ctl : POST /api/v1/ready-ring-orders/{orderId}/preparation
activate Ctl
Ctl -> Svc : prepare(actor, orderId)
activate Svc
Svc -> Orders : lock(orderId)
activate Orders
Orders --> Svc : order (branch, state)
deactivate Orders
alt Order Outside the Staff's Branches
  Svc --> Ctl : Throw ResponseStatusException (403)
  Ctl --> UI : HTTP 403
  UI --> Staff : Display error message
else Already Prepared
  Svc --> Ctl : earlier Result (PREPARED)
  Ctl --> UI : HTTP 200 Result
else Order Not Paid or Not a Store-Pickup Order
  Svc --> Ctl : Throw ResponseStatusException (409)
  Ctl --> UI : HTTP 409
  UI --> Staff : Display error message
else Paid Store-Pickup Order of the Staff's Branch
  Svc -> Orders : markPrepared(orderId)
  activate Orders
  Orders --> Svc : updated order
  deactivate Orders
  Svc -> Repo : saveAndFlush(PickupEvidence PREPARED)
  activate Repo
  Repo -> DB : INSERT retail_pickup_evidence
  activate DB
  DB --> Repo : inserted row
  deactivate DB
  Repo --> Svc : PickupEvidence
  deactivate Repo
  Svc --> Ctl : Result (PREPARED)
  Ctl --> UI : HTTP 200 Result
  UI --> Staff : Move the order to "Chờ khách nhận"
end
deactivate Svc
deactivate Ctl

Staff -> UI : Check the order code shown by the Member and click "Giao cho khách"
UI -> Ctl : POST /api/v1/ready-ring-orders/{orderId}/pickup-confirmations
activate Ctl
Ctl -> Svc : handOver(actor, orderId)
activate Svc
Svc -> Orders : lock(orderId)
activate Orders
Orders --> Svc : order
deactivate Orders
alt Order Outside the Staff's Branches
  Svc --> Ctl : Throw ResponseStatusException (403)
  Ctl --> UI : HTTP 403
  UI --> Staff : Display error message
else Order Not Prepared Yet or Not Waiting for Pickup
  Svc --> Ctl : Throw ResponseStatusException (409)
  Ctl --> UI : HTTP 409
  UI --> Staff : Display error message
else Order Prepared and Waiting for Pickup
  Svc -> Orders : markHandedOver(orderId)
  activate Orders
  Orders --> Svc : completed order
  deactivate Orders
  Svc -> Repo : saveAndFlush(PickupEvidence HANDED_OVER)
  activate Repo
  Repo -> DB : INSERT retail_pickup_evidence
  activate DB
  DB --> Repo : inserted row
  deactivate DB
  Repo --> Svc : PickupEvidence
  deactivate Repo
  Svc --> Ctl : Result (HANDED_OVER)
  Ctl --> UI : HTTP 200 Result
  UI --> Staff : Move the order to "Hoàn thành"
end
deactivate Svc
deactivate Ctl
deactivate UI
@enduml
