@startuml
!pragma charset UTF-8
skinparam shadowing false
skinparam roundcorner 0
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 70
skinparam ArrowColor #000000
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontStyle bold
  AttributeFontStyle plain
}
hide circle
hide stereotype

class CheckoutController {
  -RetailActorResolver actorResolver
  -RetailPaymentService paymentService
  +initiatePayment(HttpServletRequest request, String checkoutId) PaymentRedirectView
}

class VnpayPaymentIngressController {
  -PaymentIngressService ingress
  +receive(Map<String,String> params) Map<String,String>
}

class RetailCheckoutCancellationController {
  -RetailActorResolver actors
  -RetailCheckoutCancellationService cancellation
  +cancel(HttpServletRequest request, String checkoutId, String key) CancellationView
  +cancelBranchOrder(HttpServletRequest request, String orderId, String key) CancellationView
}

class RetailOrderQueryController {
  -RetailActorResolver actors
  -RetailOrderQueryService orders
  +list(HttpServletRequest request) List<RetailOrderHistoryView>
  +detail(HttpServletRequest request, String orderId) RetailOrderHistoryView
}

class PaymentRedirectView {
  -String checkoutId
  -String paymentUrl
  -String expiresAt
  -String paymentState
}

class RetailVerifiedPayment {
  -String checkoutId
  -String merchantReference
  -String providerTransaction
  -long amountVnd
  -String currency
}

class CancellationView {
  -GroupedCheckoutView checkout
  -int unrestoredQuantity
  -String message
}

class RetailOrderHistoryView {
  -String id
  -String orderCode
  -Long locationId
  -String fulfilmentMethod
  -String paymentState
  -String fulfilmentState
  -String subtotal
  -String shippingCharge
  -String discountAmount
  -String payableAmount
  -List<Item> items
  -String paymentMethod
  -Instant paymentDeadline
  -Instant counterPaymentDeadline
  -Instant orderedAt
  -Instant paidAt
  -Instant completedAt
}

class RetailPaymentService {
  -RetailCheckoutService checkoutService
  -RetailPaymentPort paymentPort
  -ObjectProvider<RetailUnstartedExpiryService> expiryService
  -RetailShipmentCreationService shipmentCreation
  +initiate(Long memberAccountId, String checkoutId) PaymentRedirectView
}

class RetailCheckoutService {
  -GroupedCheckoutRepository checkoutRepository
  +lockOwnedCheckout(Long memberAccountId, String checkoutId) GroupedCheckout
}

class RetailPaymentPort {
  +initiate(String checkoutId, BigDecimal amount) PaymentInitiation
}

class VnpayRetailPaymentAdapter {
  -PaymentGatewayCheckoutPort gateway
  -PaymentOwnerRegistrationPort owners
  -RetailVariantHoldRepository holds
  +initiate(String checkoutId, BigDecimal amount) PaymentInitiation
}

class PaymentIngressService {
  -VnpayChecksumService checksum
  -PaymentOwnerRegistry registry
  -RetailPaymentEvidenceFacade retail
  +receive(Map<String,String> params) Outcome
}

class RetailPaymentEvidenceFacade {
  +applyVerifiedPayment(RetailVerifiedPayment payment) void
}

class RetailPaymentEvidenceService {
  -GroupedCheckoutRepository checkouts
  -RetailVariantHoldRepository holdRepository
  -RetailVariantHoldLifecycleService holds
  -RetailPaymentReconciliationRepository reconciliation
  -CatalogueSalesFacade catalogue
  -AvailabilityGuardPort guard
  -LoyaltyFacade loyalty
  -RetailShipmentCreationService shipmentCreation
  +applyVerifiedPayment(RetailVerifiedPayment payment) void
}

class RetailCheckoutCancellationService {
  -RetailCartRepository carts
  -GroupedCheckoutRepository checkouts
  -RetailOrderRepository orders
  -RetailVariantHoldLifecycleService holds
  -CatalogueSalesFacade catalogue
  -AvailabilityGuardPort guard
  -LoyaltyFacade loyalty
  -RetailBranchPartService branchParts
  +cancel(Long memberId, String checkoutId) CancellationView
  +cancelBranchOrder(Long memberId, String orderId) CancellationView
}

class RetailUnstartedExpiryJob {
  -RetailVariantHoldRepository holds
  -RetailUnstartedExpiryService expiry
  +process() void
}

class RetailUnstartedExpiryService {
  -RetailCartRepository carts
  -GroupedCheckoutRepository checkouts
  -RetailVariantHoldLifecycleService holds
  -LoyaltyFacade loyalty
  -RetailBranchPartService branchParts
  +requirePaymentBeforeDeadline(String checkoutId) void
  +expire(Long memberId, String checkoutId) boolean
}

class RetailOrderQueryService {
  -RetailOrderRepository orders
  -RetailCataloguePort catalogue
  +list(Long memberId) List<RetailOrderHistoryView>
  +find(Long memberId, String orderId) RetailOrderHistoryView
}

class RetailShipmentCreationService {
  -RetailShipmentRepository shipments
  +createShipmentsForPaidCheckout(GroupedCheckout checkout) void
}

class RetailVariantHoldLifecycleService {
  -RetailVariantHoldRepository holds
  +requireBranchHolds(String checkoutId, List<BranchVariant> keys) List<RetailVariantHold>
  +settle(RetailVariantHold hold) void
  +release(RetailVariantHold hold) void
  +expire(RetailVariantHold hold) void
}

class LoyaltyFacade {
  +settleAcceptedBenefits(AuthoritativeOutcome outcome) BenefitResult
  +grantEarnedPoints(AuthoritativeOutcome outcome) BenefitResult
  +releaseHeldBenefits(AuthoritativeOutcome outcome) BenefitResult
}

class GroupedCheckoutRepository {
  +lockOwned(String id, Long memberId) Optional<GroupedCheckout>
  +lockById(String id) Optional<GroupedCheckout>
}

class RetailOrderRepository {
  +findOwnedOrders(Long memberId) List<RetailOrder>
  +findOwnedOrder(Long memberId, String orderId) Optional<RetailOrder>
}

class RetailCartRepository {
  +findLockedByMemberAccountId(Long memberAccountId) Optional<RetailCart>
}

class RetailVariantHoldRepository {
  +findByGroupedCheckoutId(String groupedCheckoutId) List<RetailVariantHold>
  +findUnstartedExpiryCandidates(RetailVariantHoldStatus holdStatus, ...) List<ExpiryCandidate>
}

class RetailPaymentReconciliationRepository {
  +findByMerchantReference(String merchantReference) Optional<RetailPaymentReconciliation>
}

class GroupedCheckout {
  -String id
  -Long memberAccountId
  -BigDecimal payableAmount
  -PaymentState paymentState
  -Instant paymentInitiatedAt
  -String paymentUrl
  -Instant paymentUrlExpiresAt
  -String paymentProofRef
  -Integer cancellationUnrestoredQuantity
  -Instant counterPaymentDeadline
  -List<RetailOrder> orders
}

class RetailOrder {
  -String id
  -GroupedCheckout groupedCheckout
  -Long locationId
  -String fulfilmentMethod
  -PaymentState paymentState
  -String fulfilmentState
  -BigDecimal payableAmount
  -Instant paidAt
  -Instant completedAt
  -List<OrderItem> items
}

class OrderItem {
  -String id
  -RetailOrder retailOrder
  -Long variantId
  -int quantity
  -BigDecimal unitPrice
  -BigDecimal lineTotal
}

class RetailVariantHold {
  -String id
  -GroupedCheckout groupedCheckout
  -Long variantId
  -Long locationId
  -int quantity
  -RetailVariantHoldStatus status
  -Instant expiresAt
}

class RetailCart {
  -String id
  -Long memberAccountId
  -Long version
  -List<CartLine> lines
}

class RetailPaymentReconciliation {
  -Long id
  -String checkoutId
  -String merchantReference
  -String providerTransaction
  -Long amountVnd
  -String currencyCode
  -String reason
  -Instant createdAt
}

CheckoutController ..> PaymentRedirectView
CheckoutController --> RetailPaymentService
VnpayPaymentIngressController --> PaymentIngressService
RetailCheckoutCancellationController ..> CancellationView
RetailCheckoutCancellationController --> RetailCheckoutCancellationService
RetailOrderQueryController ..> RetailOrderHistoryView
RetailOrderQueryController --> RetailOrderQueryService

RetailPaymentService --> RetailCheckoutService
RetailPaymentService --> RetailPaymentPort
RetailPaymentService --> RetailUnstartedExpiryService
RetailPaymentService --> RetailShipmentCreationService
VnpayRetailPaymentAdapter ..|> RetailPaymentPort
RetailCheckoutService --> GroupedCheckoutRepository
PaymentIngressService --> RetailPaymentEvidenceFacade
PaymentIngressService ..> RetailVerifiedPayment
RetailPaymentEvidenceService ..|> RetailPaymentEvidenceFacade
RetailPaymentEvidenceService --> GroupedCheckoutRepository
RetailPaymentEvidenceService --> RetailPaymentReconciliationRepository
RetailPaymentEvidenceService --> RetailVariantHoldLifecycleService
RetailPaymentEvidenceService --> RetailShipmentCreationService
RetailPaymentEvidenceService --> LoyaltyFacade
RetailCheckoutCancellationService --> RetailCartRepository
RetailCheckoutCancellationService --> GroupedCheckoutRepository
RetailCheckoutCancellationService --> RetailOrderRepository
RetailCheckoutCancellationService --> RetailVariantHoldLifecycleService
RetailCheckoutCancellationService --> LoyaltyFacade
RetailUnstartedExpiryJob --> RetailVariantHoldRepository
RetailUnstartedExpiryJob --> RetailUnstartedExpiryService
RetailUnstartedExpiryService --> RetailCartRepository
RetailUnstartedExpiryService --> GroupedCheckoutRepository
RetailUnstartedExpiryService --> RetailVariantHoldLifecycleService
RetailUnstartedExpiryService --> LoyaltyFacade
RetailOrderQueryService --> RetailOrderRepository
RetailVariantHoldLifecycleService --> RetailVariantHoldRepository

GroupedCheckoutRepository ..> GroupedCheckout
RetailOrderRepository ..> RetailOrder
RetailCartRepository ..> RetailCart
RetailVariantHoldRepository ..> RetailVariantHold
RetailPaymentReconciliationRepository ..> RetailPaymentReconciliation

GroupedCheckout "1" *-- "*" RetailOrder
RetailOrder "1" *-- "*" OrderItem
GroupedCheckout "1" -- "*" RetailVariantHold
@enduml
