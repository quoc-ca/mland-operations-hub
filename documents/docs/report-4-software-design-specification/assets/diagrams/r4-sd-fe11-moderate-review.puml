@startuml
!include r4-sequence-style.puml
title FE-11 Staff or Manager Moderates and Replies
actor "Staff" as staff
actor "Manager" as manager
participant "ReviewModerationController" as moderationController
participant "ReviewService" as reviewService
database "ReviewRepository" as reviewRepository
database "ReviewModerationEventRepository" as eventRepository
database "ReviewReplyRepository" as replyRepository

staff -> moderationController : hide review + version
activate moderationController
moderationController -> reviewService : authorize Staff scope
activate reviewService
reviewService -> reviewRepository : set HIDDEN
activate reviewRepository
reviewRepository --> reviewService : hidden review
deactivate reviewRepository
reviewService -> eventRepository : append audit
activate eventRepository
eventRepository --> reviewService : audit recorded
deactivate eventRepository
reviewService --> moderationController : moderation result
deactivate reviewService
moderationController --> staff : result
deactivate moderationController
manager -> moderationController : remove or reply + version
activate moderationController
moderationController -> reviewService : authorize Manager action
activate reviewService
reviewService -> reviewRepository : set REMOVED when requested
activate reviewRepository
reviewRepository --> reviewService : updated visibility
deactivate reviewRepository
reviewService -> replyRepository : create or edit current reply
activate replyRepository
replyRepository --> reviewService : current reply
deactivate replyRepository
reviewService -> eventRepository : append audit
activate eventRepository
eventRepository --> reviewService : audit recorded
deactivate eventRepository
reviewService --> moderationController : moderation result
deactivate reviewService
moderationController --> manager : result
deactivate moderationController

note over staff,manager
Admin has technical/audit access only.
end note
@enduml
