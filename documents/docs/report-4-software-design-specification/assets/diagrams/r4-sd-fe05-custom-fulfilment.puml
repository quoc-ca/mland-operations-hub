@startuml
!include r4-sequence-style.puml
title FE-05 Fulfil Paid Custom Order
actor "Staff" as staff
actor "Manager" as manager
actor "Member" as member
participant "CustomOrderService" as orderService
participant "ProductionFulfilmentFacade" as fulfilmentFacade
database "CustomOrderRepository" as orderRepository

staff -> orderService : open PAID order
activate orderService
orderService -> orderRepository : load paid order
activate orderRepository
orderRepository --> orderService : paid order
deactivate orderRepository
orderService -> fulfilmentFacade : start production
activate fulfilmentFacade
fulfilmentFacade --> orderService : IN_PRODUCTION
deactivate fulfilmentFacade
orderService --> staff : production started
deactivate orderService
staff -> orderService : record fulfilment handoff
activate orderService
orderService -> fulfilmentFacade : mark fulfilled
activate fulfilmentFacade
fulfilmentFacade --> orderService : FULFILLED
deactivate fulfilmentFacade
orderService --> member : order status update
deactivate orderService
manager -> orderService : close completed order
activate orderService
orderService --> manager : order closed
deactivate orderService
@enduml
