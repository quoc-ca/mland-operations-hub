@startuml
!pragma charset UTF-8
hide footbox
skinparam shadowing false
skinparam roundcorner 0
skinparam sequenceMessageAlign center
skinparam SequenceLifeLineBorderColor #555555
skinparam SequenceLifeLineBackgroundColor #FFFFFF
skinparam SequenceGroupBorderColor #000000
skinparam SequenceGroupBackgroundColor #FFFFFF
skinparam SequenceStereotypeFontSize 9
skinparam SequenceStereotypeFontStyle italic
skinparam ParticipantPadding 20
skinparam BoxPadding 10
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam ArrowColor #000000
skinparam SequenceGroupHeaderFontStyle plain

actor "GHTK Partner\n(role CARRIER)" as Carrier
participant "CarrierPages" as CarrierUI <<user interaction>>
participant ":CarrierShipmentController" as CarrierCtl <<control>>
participant ":CarrierShipmentService" as CarrierSvc <<service>>
participant ":RetailShipmentRepository" as Repo <<repository>>
participant "MySQL Database" as DB <<database>>

Carrier -> CarrierUI : Sign in and open the shipment list
activate CarrierUI
CarrierUI -> CarrierCtl : GET /api/v1/carrier/shipments?status&page&size
activate CarrierCtl
CarrierCtl -> CarrierSvc : list(actor, status, page, size)
activate CarrierSvc
alt Not an Active CARRIER Account
  CarrierSvc --> CarrierCtl : Throw RetailUnauthorizedException / RetailAccessDeniedException
  CarrierCtl --> CarrierUI : HTTP 401 / HTTP 403
  CarrierUI --> Carrier : Display access denied message
else Active CARRIER Account
  CarrierSvc -> Repo : findCarrierShipments(status, pageable)
  activate Repo
  Repo -> DB : SELECT retail_shipments of every branch
  activate DB
  DB --> Repo : shipment rows
  deactivate DB
  Repo --> CarrierSvc : page of RetailShipment
  deactivate Repo
  CarrierSvc --> CarrierCtl : CarrierShipmentDtos.Page (no prices, vouchers or points)
  CarrierCtl --> CarrierUI : HTTP 200
  CarrierUI --> Carrier : Display tabs "Đang lấy hàng", "Đang giao hàng", "Đã giao hàng"

  Carrier -> CarrierUI : Click "Đã lấy hàng" (or "Giao thành công" when HANDED_TO_CARRIER or IN_TRANSIT)
  CarrierUI -> CarrierCtl : POST /api/v1/carrier/shipments/{id}/transitions ({action: PICKED_UP or DELIVERED, expectedVersion})
  CarrierCtl -> CarrierSvc : transition(actor, id, action, expectedVersion)
  CarrierSvc -> Repo : lockById(id)
  activate Repo
  Repo -> DB : SELECT FOR UPDATE retail_shipments
  activate DB
  DB --> Repo : locked shipment
  deactivate DB
  Repo --> CarrierSvc : RetailShipment
  deactivate Repo
  alt Version Changed or Step Not Allowed in the Current State
    CarrierSvc --> CarrierCtl : Throw RetailConflictException
    CarrierCtl --> CarrierUI : HTTP 409 "Đơn vừa được cập nhật, hãy tải lại danh sách."
    CarrierUI --> Carrier : Display error message
  else PICKED_UP from READY_FOR_CARRIER, or DELIVERED from HANDED_TO_CARRIER or IN_TRANSIT
    CarrierSvc -> CarrierSvc : advanceTo(HANDED_TO_CARRIER or DELIVERED) and sync the branch order state
    CarrierSvc -> Repo : flush()
    activate Repo
    Repo -> DB : UPDATE retail_shipments and INSERT retail_shipment_status_history
    activate DB
    DB --> Repo : updated rows count
    deactivate DB
    Repo --> CarrierSvc : Return
    deactivate Repo
    CarrierSvc --> CarrierCtl : TransitionResult
    CarrierCtl --> CarrierUI : HTTP 200
    CarrierUI --> Carrier : Move the shipment to "Đang giao hàng" (or "Đã giao hàng")
  end
end
deactivate CarrierSvc
deactivate CarrierCtl
deactivate CarrierUI
@enduml
