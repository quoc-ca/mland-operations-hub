# ==============================================================================
# INFRA MANAGEMENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Cấu hình Firebase Google Sign-In (Tái sử dụng cùng project với ppswbs_frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# 2. Danh sách Email được phép đăng nhập vào Staging Control Room (phân cách bằng dấu phẩy)
VITE_ALLOWED_EMAILS=

# 3. AWS Lambda Control API Function URL (Sau khi terraform apply, dán URL nhận được vào đây)
VITE_CONTROL_API_URL=

# 4. Realtime SSE Log Streamer qua Cloudflare Tunnel (tùy chọn, fallback sang SSM nếu để trống)
VITE_LOG_STREAM_URL=https://logs.mland-demo.io.vn
VITE_LOG_STREAM_TOKEN=
