# ==============================================================================
# Docker Compose Multi-Worktree Configuration Template
# ==============================================================================
# Tên project (phân tách container name, network name và docker volume để không đụng worktree khác)
COMPOSE_PROJECT_NAME=mland-fe07

# Cấu hình Port trên máy Host (Mỗi worktree chọn 1 dải port riêng)
# Worktree 1 mặc định: DB 3306, BE 8080, FE 5173
# Worktree 2 (gợi ý):   DB 3307, BE 8081, FE 5174
# Worktree 3 (gợi ý):   DB 3308, BE 8082, FE 5175
HOST_DB_PORT=3307
HOST_BE_PORT=8081
HOST_FE_PORT=5174

# Cấu hình Database
DB_NAME=ppswbs_dev_fe07
DB_USER=root
DB_PASSWORD=sa123123

# Firebase backend configs
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
