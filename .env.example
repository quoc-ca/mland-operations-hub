# ==============================================================================
# Docker Compose Environment Template (.env)
# ==============================================================================
# Copy file này thành .env để cấu hình local hoặc deployment:
#   cp .env.example .env
# Lưu ý: File .env đã được cấu hình trong .gitignore, không commit lên git!

# 1. Tên project Docker (Dùng để phân tách container, network, volume giữa các worktree/môi trường)
# Mặc định: mland
# Với worktree phụ (ví dụ feat-07): mland-fe07
COMPOSE_PROJECT_NAME=mland

# 2. Cấu hình Port trên máy Host
# Mặc định (Main/Single instance):
HOST_DB_PORT=3306
HOST_BE_PORT=8080
HOST_FE_PORT=5173

# Gợi ý cho Worktree 2 (nếu worktree 1 đang chiếm port mặc định):
# HOST_DB_PORT=3307
# HOST_BE_PORT=8081
# HOST_FE_PORT=5174

# 3. Cấu hình Database
DB_NAME=ppswbs_dev
DB_USER=root
DB_PASSWORD=sa123123

# 4. Firebase Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# 5. Cấu hình Production Deployment (nếu chạy qua docker-compose.prod.yml)
# PROD_API_BASE_URL=https://api.yourdomain.com
