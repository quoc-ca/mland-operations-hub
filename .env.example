# ==============================================================================
# Docker Compose Root Environment Template (.env)
# ==============================================================================
# File này chỉ quản lý hạ tầng và orchestration cho Docker Compose:
# - Cấu hình chi tiết Backend: vui lòng xem tại ppswbs_backend/.env (.env.example)
# - Cấu hình chi tiết Frontend: vui lòng xem tại ppswbs_frontend/.env (.env.example)
#
# Docker Compose sẽ tự động nạp ppswbs_backend/.env và ppswbs_frontend/.env
# cho từng container tương ứng.
# ==============================================================================

# 1. Tên project Docker (Dùng để phân tách container, network, volume giữa các worktree/môi trường)
# Mặc định: mland
# Với worktree phụ (ví dụ feat-07): mland-fe07
COMPOSE_PROJECT_NAME=mland

# 2. Cấu hình Port trên máy Host
# Mặc định (Main/Single instance):
HOST_DB_PORT=3306
HOST_BE_PORT=8080
HOST_FE_PORT=5173

# Gợi ý cho Worktree 2 (nếu worktree 1 đang chiếm port mặc định):
# HOST_DB_PORT=3307
# HOST_BE_PORT=8081
# HOST_FE_PORT=5174

# 3. Cấu hình Database nội bộ Docker
DB_NAME=ppswbs_dev
DB_USER=root
DB_PASSWORD=sa123123

# 4. Cấu hình Production Deployment (nếu chạy qua docker-compose.prod.yml)
# PROD_API_BASE_URL=https://api.yourdomain.com
