# [Proxy Architecture]
# 1. Local dev: Vite Dev Server tự động proxy tất cả request /api/* sang http://localhost:8080 (cấu hình tại vite.config.js).
#    Do đó KHÔNG CẦN cấu hình bất kỳ biến base URL nào ở local!
# 2. Vercel deployment: Vercel Rewrites tự động proxy ngầm /api/* sang EC2 Backend qua HTTP (cấu hình tại vercel.json).
#    Trên Vercel Dashboard (Settings -> Environment Variables), chỉ cần khai báo duy nhất:
#    BACKEND_URL=http://<your-ec2-eip> (ví dụ: http://54.255.10.20)
# Firebase web app config (public values, not secrets) used by src/shared/auth. Without them sign-in is unavailable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Dev-only payment simulator QR (leave empty to disable)
VITE_PAYMENT_SIMULATOR_BASE_URL=
# Dev-only: set to "simulator" so the QR opens the fake VNPay page (needs VITE_PAYMENT_SIMULATOR_BASE_URL); empty = QR carries the real VNPay link
VITE_PAYMENT_QR_MODE=
